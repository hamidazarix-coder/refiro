---
import '../../../styles/global.css';
import { discounts } from '../../../data/discounts.js';
export function getStaticPaths() { return discounts.map((item) => ({ params: { slug: item.slug }, props: { item } })); }
const { item } = Astro.props;
const title = `${item.title} | رفیرو`;
const description = `${item.summary} کد: ${item.code}. اعتبار را پیش از خرید بررسی کن.`;
---
<!doctype html>
<html lang="fa" dir="rtl">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="theme-color" content="#101110" /><link rel="canonical" href={`https://refiro.ir/discounts/${item.slug}/`} /><link rel="icon" type="image/png" href="/favicon.png" sizes="128x128" /><title>{title}</title></head>
<body>
<header class="site-header"><div class="site-header-inner"><a class="site-brand" href="/" aria-label="رفیرو، صفحه اصلی"><span class="site-brand-mark">R</span><span class="site-brand-word">رفیرو</span></a><nav class="site-nav" aria-label="ناوبری اصلی"><a href="/codes/">کدهای دعوت</a><a href="/discounts/">کدهای تخفیف</a><a href="/#searchForm">جست‌وجو</a></nav></div></header>
<main class="wrap result discount-detail"><nav class="breadcrumbs" aria-label="مسیر صفحه"><a href="/">صفحه اصلی</a><span>/</span><a href="/discounts/">کدهای تخفیف</a><span>/</span><span aria-current="page">{item.store}</span></nav>
<section class="intro"><h1 class="page-title">{item.title}</h1><p class="page-desc">{item.summary}</p></section>
<article class="card"><div class="card-head"><div class="platform"><span class="mark">%</span><div><div class="platform-name">{item.store}</div><div class="platform-caption">{item.category}</div></div></div><span class="discount-status">اعتبار بررسی‌نشده</span></div>
<section class="reward"><div class="reward-amount">{item.value}</div><p>وضعیت فعال بودن این کد در حال حاضر تأیید نشده است.</p></section>
<div class="label">کد تخفیف</div><div class="code-row"><span class="code" id="discountCode">{item.code}</span><button class="copy" id="copyDiscount" type="button">کپی کد</button></div><p class="copy-feedback" id="copyFeedback" role="status" aria-live="polite"></p>
<ul class="discount-conditions">{item.conditions.map((condition) => <li>{condition}</li>)}</ul><a class="primary" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">بررسی پیشنهاد در منبع ←</a><p class="note">رفیرو مستقل از {item.store} و وب‌سایت منبع است. پیش از پرداخت، کد را در سبد خرید امتحان کن؛ از اعتبار یا پذیرش آن تضمینی داده نمی‌شود.</p></article>
<p class="discount-back"><a href="/discounts/">← بازگشت به همه کدهای تخفیف</a> · <a href="/codes/">مشاهده کدهای دعوت رفیرو</a></p></main>
<footer class="foot"><div class="wrap footer-inner"><a class="footer-brand" href="/">رفیرو</a><nav class="footer-links"><a href="/codes/">کدهای دعوت</a><a href="/discounts/">کدهای تخفیف</a><a href="/about/">درباره رفیرو</a></nav></div></footer>
<style>.discount-detail .card-head{margin:0;padding:20px 24px;border-bottom:1px solid #38372e;background:linear-gradient(110deg,#242116,#191a16)}.discount-detail .platform-caption{color:#aaa99f;font-size:12px}.discount-status{padding:5px 9px;border:1px solid #62502b;border-radius:999px;color:#d9bc79;font-size:11px;white-space:nowrap}.discount-detail .discount-conditions{margin:22px 24px 0;padding-right:22px;color:#c9c6b9;font-size:13px;line-height:2.2}.discount-detail .primary{width:calc(100% - 48px);margin:18px 24px 0}.discount-detail .note{margin:16px 24px 22px;line-height:2}.discount-back{margin-top:20px;font-size:13px}.discount-back a{color:#e2bd63;text-decoration:none}</style>
<script>
const button = document.querySelector('#copyDiscount'); const code = document.querySelector('#discountCode')?.textContent?.trim() || ''; const feedback = document.querySelector('#copyFeedback');
button?.addEventListener('click', async () => { try { await navigator.clipboard.writeText(code); if (feedback) feedback.textContent = 'کد کپی شد.'; } catch { if (feedback) feedback.textContent = 'کپی خودکار انجام نشد؛ کد را انتخاب و کپی کن.'; } });
</script></body></html>
