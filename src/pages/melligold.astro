---
import '../styles/global.css';
import { platforms } from '../data/platforms.js';

const platform = platforms.find((item) => item.id === 'melligold');

const code = 'MGP2yzf9e74n';
const referralUrl = 'https://melligold.com/pwa/account/?ref=MGP2yzf9e74n';
const title = 'کد دعوت و کد معرف ملی گلد (MGP2yzf9e74n) | رفیرو';
const description = 'کد دعوت و کد معرف ملی گلد را همراه با کد MGP2yzf9e74n و لینک ورود ببین؛ پیش از ثبت‌نام، شرایط پاداش را بررسی کن.';
---

<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#101110" />
  <link rel="canonical" href="https://refiro.ir/melligold/" />
  <link rel="icon" type="image/bmp" href="/favicon.bmp" sizes="64x64" />
  <link rel="preload" href="/fonts/iranian-sans.ttf" as="font" type="font/ttf" crossorigin />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <meta property="og:locale" content="fa_IR" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="رفیرو" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://refiro.ir/melligold/" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <title>{title}</title>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "url": "https://refiro.ir/melligold/",
    "description": description,
    "inLanguage": "fa-IR",
    "isPartOf": { "@type": "WebSite", "name": "رفیرو", "url": "https://refiro.ir/" }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "صفحه اصلی", "item": "https://refiro.ir/" },
      { "@type": "ListItem", "position": 2, "name": "همه کدهای معرف", "item": "https://refiro.ir/codes/" },
      { "@type": "ListItem", "position": 3, "name": "کد معرف ملی گلد", "item": "https://refiro.ir/melligold/" }
    ]
  })} />
</head>
<body>
  <header class="site-header">
    <div class="site-header-inner">
      <a class="site-brand" href="/" aria-label="رفیرو، صفحه اصلی"><span class="site-brand-mark">R</span><span class="site-brand-word">رفیرو</span></a>
      <nav class="site-nav" aria-label="ناوبری اصلی">
        <a href="/codes/">همه کدها</a>
        <a href="/#searchForm">جست‌وجوی کد</a>
        <a href="/guide/kod-davat/">راهنمای استفاده</a>
      </nav>
    </div>
  </header>


  <main class="wrap result">
    <nav class="breadcrumbs" aria-label="مسیر صفحه">
      <a href="/">صفحه اصلی</a><span aria-hidden="true">/</span>
      <a href="/codes/">همه کدهای معرف</a><span aria-hidden="true">/</span>
      <span aria-current="page">کد معرف ملی گلد</span>
    </nav>

    <section class="intro">
      <h1 class="page-title">کد معرف ملی گلد</h1>
      <p class="page-desc">
        کد معرف را کپی کن و برای ثبت‌نام یا بررسی شرایط دعوت، از لینک زیر وارد ملی گلد شو.
      </p>
    </section>

    <article class="card">
      <div class="card-head">
        <div class="platform">
          <img class="mark" src={platform.image} alt="لوگوی ملی گلد" />
          <span>ملی گلد</span>
        </div>
        <span class="status">کد معرف</span>
      </div>

      <div class="reward">
        <div class="reward-amount">۳ سوت طلا</div>
      </div>

      <div class="label">کد معرف شما</div>
      <div class="code-row">
        <span class="code" id="inviteCode">{code}</span>
        <button class="copy" id="copyCode" type="button">کپی کد</button>
      </div>

      <p class="hint">کد را در بخش معرف وارد کن.</p>

      <a
        class="primary"
        href={referralUrl}
        target="_blank"
        rel="sponsored nofollow noopener noreferrer"
      >
        ورود به ملی گلد با لینک معرف ↗
      </a>

      <div class="steps">
        <h2>چطور از کد استفاده کنی؟</h2>
        <ol>
          <li>کد معرف بالا را کپی کن.</li>
          <li>از طریق لینک ورود، صفحه ملی گلد را باز کن.</li>
          <li>کد معرف را در بخش مربوط وارد کن.</li>
          <li>پیش از خرید، شرایط دریافت هدیه را بررسی کن.</li>
        </ol>
      </div>
    </article>

    <p class="disclaimer">
      رفیرو یک راهنمای مستقل برای کدهای معرف است و وب‌سایت رسمی ملی گلد نیست.
    </p>

    <section class="seo-content" aria-labelledby="melligold-info-title">
      <h2 id="melligold-info-title">کد معرف ملی گلد چیست؟</h2>
      <p>کد معرف ملی گلد برای معرفی کاربر در صورت پشتیبانی سرویس از این روش استفاده می‌شود. کد نمایش‌داده‌شده در این صفحه MGP2yzf9e74n است و لینک ورود نیز در کارت بالا قرار دارد.</p>
      <h2>روش استفاده از کد دعوت ملی گلد</h2>
      <p>کد را کپی کن، از لینک همین صفحه وارد ملی گلد شو و راهنمای ثبت‌نام را دنبال کن. اگر هنگام ثبت‌نام بخش کد معرف وجود داشت، کد را در همان بخش وارد کن. قبل از هر خرید یا تکمیل ثبت‌نام، شرایطی را که خود سرویس نمایش می‌دهد بخوان.</p>
      <h2>پاداش ملی گلد به چه شرایطی بستگی دارد؟</h2>
      <p>میزان هدیه و واجدشرایط‌بودن حساب ممکن است با کمپین‌های جاری تغییر کند. برای جلوگیری از اتکا به اطلاعات قدیمی، شرایط فعلی را در وب‌سایت یا برنامه رسمی ملی گلد بررسی کن.</p>
    </section>
    <section class="related-pages" aria-label="کدهای معرف مرتبط">
      <h2>سایر کدهای معرف در رفیرو</h2>
      <p>کدهای دعوت پلتفرم‌های دیگر را هم بررسی کنید:</p>
      <nav aria-label="صفحات مرتبط">
        <a href="/codes/">همه کدهای دعوت</a>
        <a href="/taline/">کد دعوت طلاین</a>
        <a href="/zarpin/">کد دعوت زرپین</a>
        <a href="/talasea/">کد دعوت طلاسی</a>
        <a href="/blubank/">کد دعوت بلوبانک</a>
        <a href="/wepod/">کد دعوت ویپاد</a>
        <a href="/guide/kod-davat/">راهنمای کد دعوت</a>
        <a href="/about/">درباره رفیرو</a>
      </nav>
    </section>

  </main>


  <style>
    .back {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      margin-bottom: 26px;
      padding: 10px 16px;
      border: 1px solid #554728;
      border-radius: 12px;
      background: linear-gradient(135deg, #242116, #191a15);
      color: #e2bd63;
      font-size: 13px;
      font-weight: 800;
      text-decoration: none;
      box-shadow: 0 5px 18px #00000020;
      transition: background .2s ease, border-color .2s ease, transform .2s ease;
    }

    .back:hover {
      border-color: #b89a4f;
      background: linear-gradient(135deg, #332b19, #211f16);
      color: #f0d486;
      transform: translateY(-2px);
    }

    .back:focus-visible {
      outline: 2px solid #e2bd63;
      outline-offset: 3px;
    }


    .eyebrow {
      display: inline-flex;
      margin: 8px 0 12px;
      padding: 7px 12px;
      border: 1px solid #39352a;
      border-radius: 999px;
      color: #39d98a;
      background: #191812;
      font-size: .82rem;
    }

    .reward {
      margin: 22px 0;
      padding: 20px;
      border: 1px solid #554728;
      border-radius: 16px;
      background: linear-gradient(135deg, #282315, #191812);
    }

    .reward-label {
      color: #b8c9a8;
      font-size: .85rem;
    }

    .reward-amount {
      margin: 8px 0;
      color: #e2bd63;
      font-size: 1.75rem;
      font-weight: 900;
    }

    .reward p {
      margin: 0;
      color: #c9cbbf;
      line-height: 2;
      font-size: .94rem;
    }

    .status {
      padding: 6px 10px;
      border: 1px solid #24583e;
      border-radius: 999px;
      color: #d9bc79;
      font-size: .78rem;
    }

    .hint {
      margin: 12px 0 18px;
      color: #a8aaa2;
      font-size: .86rem;
      line-height: 1.9;
    }

    .steps {
      margin-top: 28px;
      padding-top: 22px;
      border-top: 1px solid #30312b;
    }

    .steps h2 {
      margin: 0 0 12px;
      color: #eee8d8;
      font-size: 1.05rem;
    }

    .steps ol {
      margin: 0;
      padding-right: 22px;
      color: #b9bbb2;
      line-height: 2.2;
    }

    .disclaimer {
      margin: 20px 0;
      color: #989a92;
      font-size: .85rem;
      line-height: 2;
    }

    .foot a {
      color: #d9bc79;
      text-decoration: none;
    }

    #copyCode:focus-visible,
    .primary:focus-visible {
      outline: 2px solid #d9bc79;
      outline-offset: 4px;
    }


  .related-pages {
    margin: 2rem 0;
    padding: 1.25rem;
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 14px;
  }
  .related-pages h2 {
    font-size: 1.15rem;
    margin: 0 0 .65rem;
  }
  .related-pages p {
    margin: 0 0 .9rem;
  }
  .related-pages nav {
    display: flex;
    flex-wrap: wrap;
    gap: .7rem;
  }
  .related-pages nav a {
    text-decoration: none;
  }


    .mark { object-fit: contain; padding: 4px; flex: 0 0 42px; }
  
    /* Coupon-detail layout inspired by the reference page */
    .result { width: min(820px, calc(100% - 32px)); padding-top: 22px; }
    .breadcrumbs { margin-bottom: 24px; }
    .intro { margin: 0 0 22px; padding: 22px 24px; border: 1px solid #38372e; border-radius: 18px; background: linear-gradient(125deg, #211f17, #171814); }
    .page-title { margin: 0 0 7px; font-size: clamp(25px, 4vw, 34px); line-height: 1.65; }
    .page-desc { margin: 0; max-width: 650px; line-height: 2.1; }
    .card { position: relative; overflow: hidden; padding: 0; border: 1px solid #5a4a2b; border-radius: 20px; background: #171814; box-shadow: 0 18px 48px #0000002b; }
    .card-head { margin: 0; padding: 22px 24px; border-bottom: 1px solid #38372e; background: linear-gradient(110deg, #242116, #191a16); }
    .platform { gap: 13px; }
    .platform-name { color: #f4f1e8; font-size: 19px; font-weight: 900; }
    .platform-caption { margin-top: 2px; color: #aaa99f; font-size: 12px; }
    .mark { width: 52px; height: 52px; flex: 0 0 52px; border: 1px solid #6a572b; border-radius: 15px; background: #fff; object-fit: contain; padding: 5px; }
    .reward { position: relative; margin: 0; padding: 24px; border: 0; border-bottom: 1px dashed #62502b; border-radius: 0; background: radial-gradient(ellipse at top right, #302719, transparent 70%), #1d1c16; text-align: center; }
    .reward::after, .reward::before { content: ""; position: absolute; bottom: -10px; width: 19px; height: 19px; border-radius: 50%; background: #101110; border: 1px solid #5a4a2b; }
    .reward::before { right: -10px; border-right: 0; border-bottom: 0; }
    .reward::after { left: -10px; border-left: 0; border-bottom: 0; }
    .reward-amount { margin: 0; color: #f0cf7b; font-size: clamp(27px, 5vw, 36px); font-weight: 950; line-height: 1.6; }
    .label { margin: 22px 24px 9px; font-size: 12px; font-weight: 700; }
    .code-row { margin: 0 24px; padding: 13px 15px; border: 1px dashed #8c713a; border-radius: 12px; background: #10110f; }
    .code { font-size: clamp(21px, 4vw, 27px); }
    .copy { padding: 10px 15px; }
    .copy-feedback { margin: 5px 24px 0; }
    .primary { width: calc(100% - 48px); min-height: 52px; margin: 13px 24px 0; border-radius: 12px; font-size: 14px; }
    .steps { margin: 23px 24px 0; padding-top: 20px; }
    .steps h2 { font-size: 16px; }
    .steps ol { font-size: 13px; }
    .note, .disclaimer { margin: 22px 24px 0; padding: 15px 0 22px; border-top: 1px solid #30312c; }
    .seo-content { margin-top: 24px; }
    @media (max-width: 520px) {
      .result { width: min(100% - 22px, 820px); padding-top: 16px; }
      .intro { padding: 16px; margin-bottom: 15px; }
      .card-head { padding: 17px 16px; }
      .mark { width: 46px; height: 46px; flex-basis: 46px; }
      .reward { padding: 21px 14px; }
      .label { margin: 20px 16px 8px; }
      .code-row { margin: 0 16px; padding: 10px; gap: 8px; }
      .copy { padding: 8px 10px; font-size: 11px; }
      .copy-feedback { margin-inline: 16px; }
      .primary { width: calc(100% - 32px); margin-inline: 16px; font-size: 12px; }
      .steps { margin-inline: 16px; }
      .note, .disclaimer { margin-inline: 16px; }
    }

  </style>

  <script>
    const copyButton = document.querySelector('#copyCode');
    const codeElement = document.querySelector('#inviteCode');

    copyButton?.addEventListener('click', async () => {
      const code = codeElement?.textContent?.trim();
      if (!code) return;

      try {
        await navigator.clipboard.writeText(code);
      } catch {
        const textarea = document.createElement('textarea');
        textarea.value = code;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();

        const copied = document.execCommand('copy');
        textarea.remove();

        if (!copied) {
          copyButton.textContent = 'کپی ناموفق';
          setTimeout(() => copyButton.textContent = 'کپی کد', 1600);
          return;
        }
      }

      copyButton.textContent = 'کپی شد ✓';
      setTimeout(() => copyButton.textContent = 'کپی کد', 1600);
    });
  </script>
</body>
</html>
