    .promo-slide.ad-slide{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:20px;opacity:0;pointer-events:none;transition:opacity .5s ease;background:radial-gradient(ellipse at 50% 0%,#30205a,#111729 75%)}
