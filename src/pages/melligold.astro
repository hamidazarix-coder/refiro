---
import '../styles/global.css';

const code = 'MGP2yzf9e74n';
const referralUrl = 'https://melligold.com/pwa/account/?ref=MGP2yzf9e74n';
const title = 'کد معرف ملی گلد | رفیرو';
const description = 'کد معرف ملی گلد را ببین، کپی کن و از طریق لینک دعوت وارد ملی گلد شو.';
---

<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#101110" />
  <link rel="canonical" href="https://refiro.ir/melligold/" />
  <title>{title}</title>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "url": "https://refiro.ir/melligold/",
    "description": description,
    "inLanguage": "fa-IR",
    "isPartOf": { "@type": "WebSite", "name": "رفیرو", "url": "https://refiro.ir/" }
  })} />
</head>
<body>
  <header>
    <div class="wrap nav">
      <a class="brand" href="/">refiro</a>
      <small>راهنمای کدهای معرف طلا</small>
    </div>
  </header>

  <main class="wrap result">
    <a class="back" href="/">← برگشت به صفحه اصلی</a>

    <div class="eyebrow">کد دعوت و راهنمای ثبت‌نام</div>
    <h1 class="page-title">کد معرف ملی گلد</h1>
    <p class="page-desc">
      کد معرف را کپی کن و برای ثبت‌نام یا بررسی شرایط دعوت، از لینک زیر وارد ملی گلد شو.
    </p>

    <article class="card">
      <div class="card-head">
        <div class="platform">
          <span class="mark">م</span>
          <span>ملی گلد</span>
        </div>
        <span class="status">کد معرف</span>
      </div>

      <div class="reward">
        <span class="reward-label">هدیه دعوت</span>
        <div class="reward-amount">۳ سوت طلا</div>
        <p>
          هدیه دعوت این کد <strong>۳ سوت طلا</strong> است.
        </p>
      </div>

      <div class="label">کد معرف شما</div>
      <div class="code-row">
        <span class="code" id="inviteCode">{code}</span>
        <button class="copy" id="copyCode" type="button">کپی کد</button>
      </div>

      <p class="hint">کد را در بخش معرف وارد کن.</p>

      <a
        class="primary"
        href={referralUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        ورود به ملی گلد با لینک معرف ↗
      </a>

      <div class="steps">
        <h2>چطور از کد استفاده کنی؟</h2>
        <ol>
          <li>کد معرف بالا را کپی کن.</li>
          <li>از طریق لینک ورود، صفحه ملی گلد را باز کن.</li>
          <li>کد معرف را در بخش مربوط وارد کن.</li>
          <li>پیش از خرید، شرایط دریافت هدیه را بررسی کن.</li>
        </ol>
      </div>
    </article>

    <p class="disclaimer">
      رفیرو یک راهنمای مستقل برای کدهای معرف است و وب‌سایت رسمی ملی گلد نیست.
    </p>

    <section class="related-pages" aria-label="کدهای معرف مرتبط">
      <h2>سایر کدهای معرف در رفیرو</h2>
      <p>کدهای دعوت پلتفرم‌های دیگر را هم بررسی کنید:</p>
      <nav aria-label="صفحات مرتبط">
        <a href="/codes/">همه کدهای معرف</a>
        <a href="/taline/">کد دعوت طلاین</a>
        <a href="/zarpin/">کد دعوت زرپین</a>
        <a href="/melligold/">کد معرف ملی گلد</a>
      </nav>
    </section>

  </main>

  <footer class="foot">
    <div class="wrap">
      <a href="/">رفیرو</a>
      <span> · راهنمای کدهای معرف</span>
    </div>
  </footer>

  <style>
    .eyebrow {
      display: inline-flex;
      margin: 8px 0 12px;
      padding: 7px 12px;
      border: 1px solid #39352a;
      border-radius: 999px;
      color: #d9bc79;
      background: #191812;
      font-size: .82rem;
    }

    .reward {
      margin: 22px 0;
      padding: 20px;
      border: 1px solid #35472d;
      border-radius: 16px;
      background: linear-gradient(135deg, #1a2117, #171a14);
    }

    .reward-label {
      color: #b8c9a8;
      font-size: .85rem;
    }

    .reward-amount {
      margin: 8px 0;
      color: #b5e58c;
      font-size: 1.9rem;
      font-weight: 900;
    }

    .reward p {
      margin: 0;
      color: #c9cbbf;
      line-height: 2;
      font-size: .94rem;
    }

    .status {
      padding: 6px 10px;
      border: 1px solid #3c382a;
      border-radius: 999px;
      color: #d9bc79;
      font-size: .78rem;
    }

    .hint {
      margin: 12px 0 18px;
      color: #a8aaa2;
      font-size: .86rem;
      line-height: 1.9;
    }

    .steps {
      margin-top: 28px;
      padding-top: 22px;
      border-top: 1px solid #30312b;
    }

    .steps h2 {
      margin: 0 0 12px;
      color: #eee8d8;
      font-size: 1.05rem;
    }

    .steps ol {
      margin: 0;
      padding-right: 22px;
      color: #b9bbb2;
      line-height: 2.2;
    }

    .disclaimer {
      margin: 20px 0;
      color: #989a92;
      font-size: .85rem;
      line-height: 2;
    }

    .foot a {
      color: #d9bc79;
      text-decoration: none;
    }

    #copyCode:focus-visible,
    .primary:focus-visible {
      outline: 2px solid #d9bc79;
      outline-offset: 4px;
    }


  .related-pages {
    margin: 2rem 0;
    padding: 1.25rem;
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 14px;
  }
  .related-pages h2 {
    font-size: 1.15rem;
    margin: 0 0 .65rem;
  }
  .related-pages p {
    margin: 0 0 .9rem;
  }
  .related-pages nav {
    display: flex;
    flex-wrap: wrap;
    gap: .7rem;
  }
  .related-pages nav a {
    text-decoration: none;
  }


</style>

  <script>
    const copyButton = document.querySelector('#copyCode');
    const codeElement = document.querySelector('#inviteCode');

    copyButton?.addEventListener('click', async () => {
      const code = codeElement?.textContent?.trim();
      if (!code) return;

      try {
        await navigator.clipboard.writeText(code);
      } catch {
        const textarea = document.createElement('textarea');
        textarea.value = code;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();

        const copied = document.execCommand('copy');
        textarea.remove();

        if (!copied) {
          copyButton.textContent = 'کپی ناموفق';
          setTimeout(() => copyButton.textContent = 'کپی کد', 1600);
          return;
        }
      }

      copyButton.textContent = 'کپی شد ✓';
      setTimeout(() => copyButton.textContent = 'کپی کد', 1600);
    });
  </script>
</body>
</html>
