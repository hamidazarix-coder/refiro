---
import '../styles/global.css';
import { platforms } from '../data/platforms.js';

const title = 'کد دعوت و کد معرف پلتفرم‌ها | رفیرو';
const description = 'کد دعوت و کد معرف طلاین، زرپین، ملی گلد، طلاسی، بلوبانک و ویپاد را در رفیرو پیدا کن؛ کد را کپی کن، لینک ثبت‌نام را باز کن و شرایط دریافت هدیه را بررسی کن.';

---

<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#101110" />
  <link rel="canonical" href="https://refiro.ir/" />
  <link rel="icon" type="image/bmp" href="/favicon.bmp" sizes="64x64" />
  <link rel="preload" href="/fonts/iranian-sans.ttf" as="font" type="font/ttf" crossorigin />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <meta property="og:locale" content="fa_IR" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="رفیرو" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://refiro.ir/" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <title>{title}</title>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "https://refiro.ir/#website",
        "name": "رفیرو",
        "alternateName": "Refiro",
        "url": "https://refiro.ir/",
        "inLanguage": "fa-IR",
        "description": description,
        "publisher": { "@id": "https://refiro.ir/#organization" }
      },
      {
        "@type": "Organization",
        "@id": "https://refiro.ir/#organization",
        "name": "رفیرو",
        "alternateName": "Refiro",
        "url": "https://refiro.ir/",
        "logo": "https://refiro.ir/refiro-logo.bmp",
        "description": "راهنمای مستقل کدهای دعوت و کدهای معرف پلتفرم‌ها"
      }
    ]
  })} />
</head>

<body>
  <header class="site-header">
    <div class="site-header-inner">
      <a class="site-brand" href="/" aria-label="رفیرو، صفحه اصلی"><span class="site-brand-mark">R</span><span class="site-brand-word">رفیرو</span></a>
      <nav class="site-nav" aria-label="ناوبری اصلی">
        <a href="/codes/">همه کدها</a>
        <a href="/#searchForm">جست‌وجوی کد</a>
        <a href="/guide/kod-davat/">راهنمای استفاده</a>
      </nav>
    </div>
  </header>

  

  <main class="wrap">
    <section class="hero">
      

      <div class="hero-brand-card">
        <span class="hero-kicker"><span aria-hidden="true">✦</span> به جیب بزن!</span>
        <h1>
          <span class="hero-brand-name">رفیرو</span>
          <span class="hero-tagline">بزرگ‌ترین مرجع کدهای دعوت در ایران</span>
        </h1>
        <div class="hero-divider"><span></span></div>
        <p>
          پلتفرمت رو پیدا کن، کد دعوتت رو بردار و مستقیم وارد شو.
        </p>
      </div>

      <form class="search" id="searchForm" role="search">
        <input
          id="searchInput"
          type="search"
          placeholder="مثلاً کد معرف طلاین"
          aria-label="جست‌وجوی پلتفرم"
          autocomplete="off"
        />
        <button type="submit">جست‌وجو</button>
      </form>

      <p class="search-hint">نام پلتفرم رو فارسی یا انگلیسی بنویس.</p>
    </section>

    <section class="platform-section" aria-labelledby="platformTitle">
      <div class="section-heading">
        <div>
          <h2 id="platformTitle">پلتفرم‌ها</h2>
          <p class="section-subtitle">پلتفرم موردنظرت رو انتخاب کن.</p>
        </div>

        
      </div>

      <div class="platform-grid" id="platformGrid">
        {platforms.map((platform) => (
          <a
            class:list={[
              'platform-tile',
              { 'platform-tile-disabled': !platform.active },
            ]}
            href={platform.href}
            aria-disabled={!platform.active ? 'true' : undefined}
            data-name={platform.name}
            data-active={platform.active ? 'true' : 'false'}
          >
            <div class="tile-top">
              {platform.image ? (
                <img class:list={['tile-logo', { 'tile-logo-wepod': platform.id === 'wepod' }]} src={platform.image} alt={platform.name} width="48" height="48" loading="lazy" decoding="async" />
              ) : (
                <span class="tile-mark">{platform.mark}</span>
              )}
              <span class="tile-reward">{platform.active ? platform.reward : 'به‌زودی'}</span>
            </div>

            <span class="tile-name">
              {platform.active ? `کد دعوت ${platform.name}` : platform.name}
            </span>

            <span class="tile-description">
              {platform.active
                ? `با کد معرف ${platform.name} ثبت‌نام کن و شرایط دریافت ${platform.reward} رو ببین.`
                : 'این پلتفرم به‌زودی به رفیرو اضافه می‌شه.'}
            </span>

            <span class="tile-bottom">
              <span class="tile-status">
                {platform.active ? 'کد دعوت فعال' : 'در حال اضافه‌شدن'}
              </span>
              <span class="tile-cta">{platform.active ? 'مشاهده کد' : 'به‌زودی'} <span aria-hidden="true">←</span></span>
            </span>
          </a>
        ))}
      </div>

      <p class="all-codes-links">
        <a href="/codes/">مشاهده همه کدهای دعوت و کدهای معرف</a>
        <span aria-hidden="true"> · </span>
        <a href="/guide/kod-davat/">راهنمای استفاده از کد دعوت</a>
        <span aria-hidden="true"> · </span>
        <a href="/about/">درباره رفیرو و روش بررسی کدها</a>
      </p>

      <p class="empty hidden" id="noResult" role="status">
        پلتفرمی با این نام پیدا نشد. نام دیگری رو امتحان کن.
      </p>
    </section>

    <section class="about faq-section" aria-labelledby="faqTitle">
      <div class="faq-list">
        <h2 class="faq-heading" id="faqTitle">راهنمای کد دعوت و کد معرف</h2>
        <article class="faq-item">
          <h3>رفیرو دقیقاً چیکار می‌کنه؟</h3>
          <p class="about-copy"><span class="about-lead">پول مفت!</span> با رفیرو کد دعوت برنامه یا سایت موردنظرت رو پیدا کن؛ کد رو کپی کن یا از لینک دعوت وارد شو و شرایط پاداش رو ببین.</p>
        </article>
        <article class="faq-item">
          <h3>کد دعوت با کد معرف چه فرقی داره؟</h3>
          <p class="about-copy">این دو اصطلاح در بسیاری از سرویس‌ها به یک کاربرد اشاره می‌کنند: کدی که هنگام ثبت‌نام برای معرفی کاربر جدید استفاده می‌شود. نام و محل واردکردن کد ممکن است در هر پلتفرم فرق داشته باشد.</p>
        </article>
        <article class="faq-item">
          <h3>چطور از کد معرف استفاده کنم؟</h3>
          <p class="about-copy">صفحه پلتفرم موردنظر را باز کن، کد را دقیق کپی کن و مراحل ثبت‌نام را از لینک رسمی ادامه بده. اگر فرم ثبت‌نام بخش کد معرف داشت، کد را همان‌جا وارد کن و پیش از تکمیل مراحل شرایط طرح را بخوان.</p>
        </article>
        <article class="faq-item">
          <h3>آیا دریافت هدیه نقدی یا طلا تضمینی است؟</h3>
          <p class="about-copy">نه لزوماً. مقدار پاداش، مهلت طرح و شرایط واجدشرایط‌بودن می‌تواند تغییر کند. اطلاعات نهایی را قبل از ثبت‌نام در سایت یا برنامه رسمی همان پلتفرم بررسی کن.</p>
        </article>
        <article class="faq-item">
          <h3>آیا رفیرو سایت رسمی این پلتفرم‌هاست؟</h3>
          <p class="about-copy">خیر؛ رفیرو یک راهنمای مستقل برای پیدا کردن کدهای دعوت است. برای ثبت‌نام و بررسی شرایط نهایی، از لینک و منابع رسمی هر سرویس استفاده کن.</p>
        </article>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap footer-inner">
      <a class="footer-brand" href="/">refiro</a>
      <nav class="footer-links" aria-label="پیوندهای تکمیلی">
        <a href="/codes/">همه کدها</a>
        <a href="/guide/kod-davat/">راهنمای کد دعوت</a>
        <a href="/about/">درباره رفیرو</a>
      </nav>
    </div>
  </footer>

  <style>
    :global(html) {
      scroll-behavior: smooth;
    }

    :global(body) {
      background:
        radial-gradient(ellipse at 50% 0%, #292315 0%, transparent 36rem),
        #101110;
    }

    .nav {
      min-height: 74px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .brand {
      color: #e2bd63;
      font-size: 27px;
      font-weight: 950;
      letter-spacing: -1px;
      text-decoration: none;
      direction: ltr;
    }

    .nav small {
      color: #aaa99f;
      font-size: 12px;
    }

    .hero {
      padding: 76px 0 28px;
      text-align: center;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      padding: 6px 13px;
      border: 1px solid #554728;
      border-radius: 999px;
      background: #211e15;
      color: #e2bd63;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 20px;
    }

    .hero h1 {
      margin: 0 0 14px;
      font-size: clamp(29px, 5vw, 43px);
      line-height: 1.65;
      font-weight: 950;
      letter-spacing: -.8px;
    }

    .hero h1 span {
      color: #e2bd63;
    }

    .hero > p:not(.search-hint) {
      max-width: 540px;
      margin: 0 auto 26px;
      color: #aaa99f;
      font-size: 14px;
      line-height: 2;
    }

    .search {
      display: flex;
      gap: 9px;
      max-width: 570px;
      margin: auto;
      padding: 7px;
      border: 1px solid #454235;
      border-radius: 16px;
      background: #191a17;
      box-shadow: 0 12px 34px #00000020;
      transition: border-color .2s ease, box-shadow .2s ease;
    }

    .search:focus-within {
      border-color: #b79a52;
      box-shadow: 0 0 0 3px #e2bd6312, 0 12px 34px #00000020;
    }

    .search input {
      min-width: 0;
      flex: 1;
      padding: 11px 13px;
      border: 0;
      outline: 0;
      background: transparent;
      color: #f4f1e8;
      font: inherit;
      font-size: 14px;
    }

    .search input::placeholder {
      color: #85857c;
    }

    .search button {
      flex-shrink: 0;
      padding: 10px 20px;
      border: 0;
      border-radius: 11px;
      background: linear-gradient(135deg, #f0d486, #d6ad4d);
      color: #17150f;
      font: inherit;
      font-size: 13px;
      font-weight: 900;
      cursor: pointer;
      transition: filter .2s ease, transform .2s ease;
    }

    .search button:hover {
      filter: brightness(1.08);
      transform: translateY(-1px);
    }

    .search-hint {
      margin: 10px 0 0;
      color: #77776e;
      font-size: 11px;
    }

    .platform-section {
      margin: 42px 0 42px;
    }

    .section-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 19px;
    }

    .section-heading h2 {
      margin: 0;
      color: #f4f1e8;
      font-size: 1.3rem;
      font-weight: 900;
      letter-spacing: -.3px;
    }

    .section-subtitle {
      margin: 3px 0 0;
      color: #85857c;
      font-size: 12px;
    }

    .section-heading .hint {
      flex-shrink: 0;
      margin: 0;
      padding: 5px 10px;
      border: 1px solid #34372e;
      border-radius: 999px;
      background: #191b17;
      color: #aaa99f;
      font-size: 11px;
    }

    .platform-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
      align-items: stretch;
    }

    /* Offer-style referral cards inspired by coupon directories */
    .platform-tile {
      min-height: 0;
      justify-content: flex-start;
      gap: 14px;
      padding: 19px;
      border: 1px solid #39372e;
      border-radius: 18px;
      background: linear-gradient(155deg, #202019 0%, #171814 72%);
      box-shadow: 0 8px 22px #00000018;
    }

    .platform-tile[href]:not([aria-disabled="true"]):hover {
      border-color: #b89a4f;
      transform: translateY(-3px);
      box-shadow: 0 15px 30px #00000035;
    }

    .tile-top {
      min-height: 48px;
    }

    .tile-reward {
      display: inline-flex;
      align-items: center;
      max-width: 70%;
      padding: 7px 10px;
      border: 1px solid #62502b;
      border-radius: 9px;
      background: #302819;
      color: #f0cf7b;
      font-size: 12px;
      font-weight: 850;
      line-height: 1.6;
      text-align: center;
    }

    .tile-name {
      display: block;
      font-size: 1.08rem;
      line-height: 1.7;
    }

    .tile-description {
      display: block;
      min-height: 52px;
      color: #aaa99f;
      font-size: 12px;
      line-height: 2;
    }

    .tile-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-top: auto;
      padding-top: 12px;
      border-top: 1px dashed #414035;
    }

    .tile-cta {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      color: #e2bd63;
      font-size: 12px;
      font-weight: 900;
      white-space: nowrap;
    }

    .platform-tile .tile-status {
      font-size: 11px;
    }

    .platform-tile-disabled .tile-reward {
      color: #aaa99f;
      border-color: #44443b;
      background: #22231f;
    }

    .platform-tile {
      position: relative;
      min-width: 0;
      min-height: 155px;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: space-between;
      gap: 12px;
      padding: 17px;
      overflow: hidden;
      border: 1px solid #34372e;
      border-radius: 19px;
      background:
        radial-gradient(ellipse at top right, #302a1b 0%, transparent 68%),
        linear-gradient(145deg, #1c1e19, #141512);
      color: #f4f1e8;
      text-decoration: none;
      box-shadow: 0 8px 24px #00000012;
      transition:
        border-color .22s ease,
        transform .22s ease,
        box-shadow .22s ease,
        background .22s ease;
    }

    .platform-tile[href]:not([aria-disabled="true"]):hover {
      border-color: #b89a4f;
      background:
        radial-gradient(ellipse at top right, #39321d 0%, transparent 68%),
        linear-gradient(145deg, #22231c, #171813);
      transform: translateY(-4px);
      box-shadow: 0 14px 30px #00000030;
    }

    .platform-tile:focus-visible {
      outline: 2px solid #e2bd63;
      outline-offset: 3px;
    }

    .tile-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .tile-mark {
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      border: 1px solid #6a572b;
      border-radius: 14px;
      background: linear-gradient(145deg, #39301b, #252318);
      color: #f0cf7b;
      font-size: 1.25rem;
      font-weight: 900;
      box-shadow: inset 0 1px #ffffff0b;
    }

    .tile-arrow {
      color: #9b8a5b;
      font-size: 19px;
      transition: color .2s ease, transform .2s ease;
    }

    .platform-tile:hover .tile-arrow {
      color: #e2bd63;
      transform: translate(-2px, -2px);
    }

    .tile-name {
      color: #f4f1e8;
      font-size: 1.05rem;
      font-weight: 900;
      line-height: 1.5;
    }

    .tile-status {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      color: #a7a99e;
      font-size: .74rem;
    }

    .platform-tile[data-active="true"] .tile-status {
      color: #39d98a;
      font-weight: 800;
    }

    .platform-tile[data-active="true"] .tile-status::before {
      content: "";
      width: 6px;
      height: 6px;
      flex: 0 0 6px;
      border-radius: 50%;
      background: #e2bd63;
      box-shadow: 0 0 9px #e2bd6355;
    }

    .platform-tile-disabled {
      opacity: .58;
      border-style: dashed;
      cursor: default;
    }

    .empty {
      margin: 20px 0 0;
      padding: 14px 16px;
      border: 1px solid #39352a;
      border-radius: 12px;
      background: #1b1a16;
      color: #c6b98f;
      font-size: 13px;
      text-align: center;
    }

    .hidden {
      display: none !important;
    }

    .about {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      column-gap: 8px;
      row-gap: 5px;
      margin: 38px 0 58px;
      padding: 22px;
      border: 1px solid #34352e;
      border-radius: 18px;
      background: linear-gradient(135deg, #1c1d18, #151612);
    }

    .faq-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
      width: 100%;
    }

    .faq-item {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 7px;
      width: 100%;
      padding: 0;
      border-top: 0;
    }

    .faq-item h3 {
      margin: 0;
      color: #f4f1e8;
      font-size: 14px;
      font-weight: 900;
      line-height: 1.9;
    }

    .about-mark {
      width: 42px;
      height: 42px;
      flex: 0 0 42px;
      display: grid;
      place-items: center;
      border: 1px solid #6a572b;
      border-radius: 13px;
      background: #302819;
      color: #e2bd63;
      font-size: 20px;
      font-weight: 950;
    }

    .about h2 {
      margin: 0 0 5px;
      color: #e2bd63;
      font-size: 15px;
      font-weight: 900;
    }

    .about p {
      margin: 0;
      color: #aaa99f;
      font-size: 12px;
      line-height: 2;
    }

    .foot {
      border-top: 1px solid #30312c;
      background: #0d0e0c;
    }

    .footer-inner {
      min-height: 75px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
    }

    .footer-brand {
      color: #e2bd63;
      font-size: 20px;
      font-weight: 950;
      letter-spacing: -.6px;
      text-decoration: none;
      direction: ltr;
    }

    .footer-inner > span {
      color: #85857c;
      font-size: 11px;
    }

    .footer-links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
    }

    .footer-links a {
      color: #d9bc79;
      font-size: 12px;
      text-decoration: none;
    }

    .footer-links a:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .codes-nav-link {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      justify-content: center;
      padding: 8px 12px;
      border: 1px solid #554728;
      border-radius: 10px;
      color: #e2bd63;
      text-decoration: none;
      font-size: 12px;
      white-space: nowrap;
      transition: background .2s ease, border-color .2s ease;
    }

    @media (max-width: 640px) {
      .nav {
        min-height: 65px;
        gap: 10px;
      }

      .codes-nav-link {
        padding: 7px 9px;
        font-size: 11px;
      }

      .hero {
        padding: 53px 0 23px;
      }

      .hero h1 {
        font-size: clamp(27px, 7.5vw, 36px);
        line-height: 1.7;
      }

      .hero > p:not(.search-hint) {
        font-size: 13px;
      }

      .platform-section {
        margin: 32px 0 36px;
      }

      .platform-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 11px;
      }

      .platform-tile {
        padding: 14px;
        gap: 11px;
      }

      .tile-description {
        min-height: 68px;
        font-size: 11px;
      }

      .tile-reward {
        max-width: 72%;
        padding: 6px 7px;
        font-size: 10px;
      }

      .tile-bottom {
        align-items: flex-start;
        flex-direction: column;
        gap: 8px;
      }

      .platform-tile {
        min-height: 137px;
        padding: 14px;
