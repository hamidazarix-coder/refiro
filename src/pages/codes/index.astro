---
import '../../styles/global.css';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { platforms } from '../../data/platforms.js';

const title = 'همه کدهای دعوت و کدهای معرف | رفیرو';
const description = 'فهرست کد دعوت و کد معرف طلاین، زرپین، ملی گلد، طلاسی، بلوبانک و ویپاد؛ کدها را کپی کن و شرایط هدیه را از منبع رسمی بررسی کن.';
---

<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#101110" />
  <script is:inline>
    (() => {
      let theme = 'dark';
      try {
        const saved = localStorage.getItem('refiro-theme');
        if (saved === 'dark' || saved === 'light') theme = saved;
      } catch {}
      document.documentElement.dataset.theme = theme;
      const themeColor = document.querySelector('meta[name="theme-color"]');
      if (themeColor) themeColor.content = theme === 'light' ? '#f5f8fc' : '#080c15';
    })();
  </script>
  <link rel="canonical" href="https://refiro.ir/codes/" />
  <link rel="icon" type="image/svg+xml" href="/refiro-logo.svg" />
  <link rel="preload" href="/fonts/iranian-sans.ttf" as="font" type="font/ttf" crossorigin />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <meta property="og:locale" content="fa_IR" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="رفیرو" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://refiro.ir/codes/" />
  <meta property="og:image" content="https://refiro.ir/og-cover.png" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="رفیرو؛ راهنمای کدهای دعوت و کد معرف" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://refiro.ir/og-cover.png" />
  <meta name="twitter:image:alt" content="رفیرو؛ راهنمای کدهای دعوت و کد معرف" />
  <title>{title}</title>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": title,
    "url": "https://refiro.ir/codes/",
    "description": description,
    "inLanguage": "fa-IR",
    "mainEntity": {
      "@type": "ItemList",
      "itemListOrder": "https://schema.org/ItemListOrderAscending",
      "numberOfItems": platforms.filter((platform) => platform.active).length,
      "itemListElement": platforms.filter((platform) => platform.active).map((platform, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": `کد دعوت ${platform.name}`,
        "url": `https://refiro.ir${platform.href}`
      }))
    },
    "isPartOf": { "@type": "WebSite", "name": "رفیرو", "url": "https://refiro.ir/" }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "صفحه اصلی", "item": "https://refiro.ir/" },
      { "@type": "ListItem", "position": 2, "name": "همه کدهای دعوت و معرف", "item": "https://refiro.ir/codes/" }
    ]
  })} />
</head>
<body>
  <Header />

  <main class="wrap codes-page">
    <nav class="breadcrumbs" aria-label="مسیر صفحه">
      <a href="/">صفحه اصلی</a><span aria-hidden="true">/</span><span aria-current="page">همه کدهای دعوت و معرف</span>
    </nav>
    <div class="section-heading section-heading-row">
      <h1>همه کدهای دعوت</h1>
      <a class="view-all" href="/">بازگشت به صفحه اصلی <span aria-hidden="true">←</span></a>
    </div>
    <p class="page-desc">کد دعوت پلتفرم موردنظرت رو پیدا کن، کپی کن و مستقیم وارد صفحه ثبت‌نام شو.</p>

    <label class="search-box">
      <span class="sr-only">جست‌وجو در کدها</span>
      <input id="codeSearch" type="search" placeholder="جست‌وجو بر اساس نام یا کد..." autocomplete="off" />
    </label>

    <div class="code-list platform-grid" id="codeList">
      {platforms.map((platform) => (
        <article class="code-card platform-card" data-search={`${platform.name} ${platform.id} ${platform.code} ${(platform.aliases || []).join(' ')}`}>
          <div class="code-card-top">
            <span class="tile-mark platform-logo">{platform.mark}</span>
            <div class="code-card-title">
              <h2>کد دعوت {platform.name}</h2>
              <span>{platform.reward ? `پاداش اعلام‌شده: ${platform.reward}` : 'کد معرف'}</span>
            </div>
          </div>

          <div class="invite-code" dir="ltr">{platform.code}</div>

          <div class="actions">
            <button class="copy-button" type="button" data-code={platform.code}>کپی کد</button>
            <a class="details-link" href={platform.href}>مشاهده کد دعوت {platform.name} ↗</a>
          </div>
        </article>
      ))}
    </div>

    <p id="emptyState" class="empty" hidden>کدی پیدا نشد؛ عبارت دیگری رو امتحان کن.</p>
    <section class="seo-content" aria-labelledby="codes-help-title">
      <h2 id="codes-help-title">چطور کد دعوت یا کد معرف را استفاده کنم؟</h2>
      <p>کد سرویس موردنظر را در این فهرست پیدا و کپی کن، سپس صفحه جزئیات آن را باز کن. از لینک رسمی وارد شو و اگر در فرایند ثبت‌نام بخش کد معرف وجود داشت، کد را دقیق همان‌طور که نمایش داده شده وارد کن.</p>
      <h2>آیا هدیه معرفی همیشه فعال است؟</h2>
      <p>خیر؛ پاداش‌ها و شرایط کمپین‌ها ممکن است تغییر کنند و گاهی به شرایط حساب یا تکمیل مراحل ثبت‌نام وابسته‌اند. مبلغ یا شرایط نهایی را از خود پلتفرم بررسی کن. <a href="/guide/kod-davat/">راهنمای کامل استفاده از کد دعوت</a> نکات بیشتر را توضیح می‌دهد.</p>
    </section>
    <p class="disclaimer">رفیرو مستقل از پلتفرم‌های معرفی‌شده است؛ برای شرایط قطعی و ثبت‌نام، منبع رسمی هر پلتفرم را بررسی کن.</p>
  </main>

  <Footer />

  <style>
    :global(body){margin:0;background:#080c15;color:#eef0ff}
    .wrap{width:min(1120px,calc(100% - 48px));margin-inline:auto}
    .codes-page{min-height:55vh;padding-top:42px;padding-bottom:60px}
    .breadcrumbs{display:flex;gap:10px;align-items:center;margin-bottom:28px;color:#9da9c2;font-size:13px}
    .breadcrumbs a{color:#a77aff;text-decoration:none}
    .section-heading{margin-bottom:16px}
    .section-heading-row{display:flex;align-items:center;justify-content:space-between;gap:12px;text-align:right}
    .section-heading h1{margin:0;font-size:clamp(23px,4vw,30px);font-weight:900}
    .view-all{display:inline-flex;align-items:center;gap:8px;color:#a77aff;text-decoration:none;font-size:13px;font-weight:800;white-space:nowrap}
    .page-desc{margin:0 0 25px;color:#aab2c9;line-height:2}
    .search-box{display:block;margin-bottom:22px}
    .search-box input{width:100%;box-sizing:border-box;padding:13px 16px;border:1px solid #58421c;border-radius:13px;background:#11110f;color:#eef0ff;font:inherit;outline:none}
    .search-box input:focus{border-color:#e5a92b}
    .code-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
    .code-card{position:relative;aspect-ratio:1/1;min-height:0;box-sizing:border-box;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:20px;border:1px solid #58421c;border-radius:15px;background:linear-gradient(145deg,#211b0e,#11110f);color:#eef0ff;text-align:center}
    .code-card-top{display:flex;flex-direction:column;align-items:center;gap:9px}
    .code-card-title{display:flex;flex-direction:column;align-items:center;gap:2px}
    .tile-mark{width:43px;height:43px;flex:0 0 43px;display:grid;place-items:center;margin:0;border-radius:50%;background:linear-gradient(145deg,#ffc53d,#e98c00);color:#fff2a4;font-weight:900;font-size:20px}
    .code-card-title h2{margin:0 0 4px;font-size:15px;font-weight:800}
    .code-card-title span{color:#bdb19a;font-size:12px}
    .invite-code{width:100%;box-sizing:border-box;margin:0;padding:12px 10px;border:1px dashed #a67a25;border-radius:11px;text-align:center;color:#ffe3a0;background:#17140e;font-size:1.05rem;font-weight:800;overflow-wrap:anywhere}
    .actions{width:100%;display:flex;flex-direction:column;gap:8px;align-items:stretch;margin-top:0}
    .copy-button{flex:1;padding:10px;border:0;border-radius:10px;background:linear-gradient(135deg,#ffc53d,#e98c00);color:#261a05;font:inherit;font-size:13px;font-weight:800;cursor:pointer}
    .details-link{color:#f0bd55;text-decoration:none;font-size:12px;text-align:center}
    .empty{margin:24px 0;color:#aab2c9;text-align:center}
    .seo-content{margin-top:38px;padding:22px;border:1px solid #58421c;border-radius:15px;background:#11110f;color:#bdb19a;line-height:2}
    .seo-content h2{color:#f6e9c9;font-size:18px;margin:0 0 8px}
    .seo-content h2:not(:first-child){margin-top:20px}
    .seo-content p{margin:0}
    .seo-content a,.disclaimer a{color:#f0bd55;text-decoration:none}
    .disclaimer{margin-top:22px;color:#929078;font-size:12px;line-height:2}
    :global(html[data-theme="light"] body){background:#f5f8fc;color:#17263a}
    :global(html[data-theme="light"] .code-card){background:#fffaf0;border-color:#ead6a7;color:#17263a}
    :global(html[data-theme="light"] .code-card-title span),:global(html[data-theme="light"] .page-desc),:global(html[data-theme="light"] .seo-content){color:#5d6b80}
    :global(html[data-theme="light"] .search-box input){background:#fffaf0;border-color:#ead6a7;color:#17263a}
    :global(html[data-theme="light"] .invite-code){background:#fff4d7;border-color:#e8ca83;color:#75500b}
    :global(html[data-theme="light"] .seo-content){background:#fffaf0;border-color:#ead6a7}
    :global(html[data-theme="light"] .seo-content h2){color:#17263a}
    @media(max-width:760px){.wrap{width:calc(100% - 28px)}.code-list{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.code-card{padding:12px;gap:9px}.tile-mark{width:38px;height:38px;flex-basis:38px}.code-card-title h2{font-size:13px}.code-card-title span{font-size:10px}.invite-code{padding:9px 6px;font-size:.9rem}.copy-button{padding:8px;font-size:12px}.details-link{padding:2px;font-size:10px}.section-heading h1{font-size:21px}.view-all{font-size:11px}}
    .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
    [hidden]{display:none!important}
  </style>

  <script>
    const normalize = (value = '') => value.toLocaleLowerCase('fa').replace(/ي/g, 'ی').replace(/ك/g, 'ک').replace(/‌/g, '').replace(/\s+/g, '').trim();
    const search = document.querySelector('#codeSearch');
    const cards = [...document.querySelectorAll('.code-card')];
    const empty = document.querySelector('#emptyState');

    search?.addEventListener('input', () => {
      const query = normalize(search.value);
      cards.forEach((card) => {
        card.hidden = query !== '' && !normalize(card.dataset.search || '').includes(query);
      });
      if (empty) empty.hidden = cards.some((card) => !card.hidden);
    });

    document.querySelectorAll('.copy-button').forEach((button) => {
      button.addEventListener('click', async () => {
        const code = button.dataset.code;
        try {
          await navigator.clipboard.writeText(code);
        } catch {
          const area = document.createElement('textarea');
          area.value = code;
          area.style.position = 'fixed';
          area.style.opacity = '0';
          document.body.appendChild(area);
          area.select();
          const copied = document.execCommand('copy');
          area.remove();
          if (!copied) {
            button.textContent = 'کپی ناموفق';
            setTimeout(() => button.textContent = 'کپی کد', 1500);
            return;
          }
        }
        button.textContent = 'کپی شد ✓';
        setTimeout(() => button.textContent = 'کپی کد', 1500);
      });
    });
  </script>
</body>
</html>
