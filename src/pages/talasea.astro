---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { platforms } from '../data/platforms.js';

const platform = platforms.find((item) => item.id === 'talasea');

const code = 'yZfgvrdj';
const referralUrl = 'https://talasea.ir/onboarding?r=yZfgvrdj';
const title = 'کد دعوت طلاسی و کد معرف طلاسی (yZfgvrdj) | رفیرو';
const description = 'کد دعوت طلاسی yZfgvrdj را کپی کن یا از لینک ثبت‌نام وارد شو. شرایط هدیه و راهنمای استفاده را پیش از تکمیل ثبت‌نام بررسی کن.';
---

<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#101110" />
  <script is:inline>
    (() => {
      let theme = 'light';
      try {
        const saved = localStorage.getItem('refiro-theme');
        if (saved === 'dark' || saved === 'light') theme = saved;
      } catch {}
      document.documentElement.dataset.theme = theme;
      const themeColor = document.querySelector('meta[name="theme-color"]');
      if (themeColor) themeColor.content = theme === 'light' ? '#f5f8fc' : '#101110';
    })();
  </script>
  <link rel="canonical" href="https://refiro.ir/talasea/" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
  <link rel="preload" href="/fonts/iranian-sans.ttf" as="font" type="font/ttf" crossorigin />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <meta property="og:locale" content="fa_IR" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="رفیرو" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://refiro.ir/talasea/" />
  <meta property="og:image" content="https://refiro.ir/og-cover.png" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="رفیرو؛ راهنمای کدهای دعوت و کد معرف" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://refiro.ir/og-cover.png" />
  <meta name="twitter:image:alt" content="رفیرو؛ راهنمای کدهای دعوت و کد معرف" />
  <title>{title}</title>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "url": "https://refiro.ir/talasea/",
    "description": description,
    "inLanguage": "fa-IR",
    "isPartOf": { "@type": "WebSite", "name": "رفیرو", "url": "https://refiro.ir/" }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "صفحه اصلی", "item": "https://refiro.ir/" },
      { "@type": "ListItem", "position": 2, "name": "همه کدهای معرف", "item": "https://refiro.ir/codes/" },
      { "@type": "ListItem", "position": 3, "name": "کد دعوت طلاسی", "item": "https://refiro.ir/talasea/" }
    ]
  })} />
</head>

<body>
  <Header />


  <main class="wrap result">
    <nav class="breadcrumbs" aria-label="مسیر صفحه">
      <a href="/">صفحه اصلی</a><span aria-hidden="true">/</span>
      <a href="/codes/">همه کدهای معرف</a><span aria-hidden="true">/</span>
      <span aria-current="page">کد دعوت طلاسی</span>
    </nav>

    <section class="intro">
      <h1 class="page-title">کد دعوت طلاسی</h1>
      <p class="page-desc">
        کد رو کپی کن یا از طریق لینک زیر وارد صفحه ثبت‌نام طلاسی شو.
      </p>
    </section>

    <article class="card">
      <div class="card-head">
        <div class="platform">
          <img class="mark" src={platform.image} alt="لوگوی طلاسی" />
          <div>
            <div class="platform-name">طلاسی</div>
            <div class="platform-caption">کد معرف اختصاصی</div>
          </div>
        </div>
        <span class="status"><span></span> فعال</span>
      </div>

      <section class="reward">
        <div class="reward-amount">بررسی شرایط هدیه</div>
      </section>

      <div class="label">کد دعوت شما</div>

      <div class="code-row">
        <span class="code" id="inviteCode">{code}</span>
        <button class="copy" id="copyCode" type="button">
          کپی کد
        </button>
      </div>

      <p class="copy-feedback" id="copyFeedback" role="status" aria-live="polite"></p>

      <a
        class="primary"
        href={referralUrl}
        target="_blank"
        rel="sponsored nofollow noopener noreferrer"
      >
        ثبت‌نام در طلاسی با لینک دعوت <span aria-hidden="true">↗</span>
      </a>

      <div class="steps">
        <h2>چطور از کد استفاده کنی؟</h2>
        <ol>
          <li>کد دعوت بالا رو کپی کن.</li>
          <li>از طریق لینک ثبت‌نام وارد طلاسی شو.</li>
          <li>کد معرف رو در بخش مربوط وارد کن.</li>
        </ol>
      </div>

      <p class="note">
        رفیرو یک راهنمای مستقل است و وابستگی رسمی به طلاسی ندارد.
      </p>
    </article>


    <section class="steps" aria-label="راهنمای کد دعوت طلاسی">
      <h2>کد معرف طلاسی چیست؟</h2>
      <p>
        کد معرف طلاسی برای ثبت‌نام در این صفحه
        yZfgvrdj است.
      </p>

      <h2>چطور از کد دعوت طلاسی استفاده کنم؟</h2>
      <p>
        از لینک ثبت‌نام همین صفحه وارد طلاسی شو و
        کد yZfgvrdj را در بخش کد معرف وارد کن.
      </p>

      <h2>شرایط هدیه کد دعوت طلاسی چیست؟</h2>
      <p>مقدار و شرایط هرگونه هدیه ممکن است به کمپین فعال بستگی داشته باشد؛ اطلاعات قطعی را هنگام ثبت‌نام از خود طلاسی بررسی کن.</p>

      <h2>آیا رفیرو سایت رسمی طلاسی است؟</h2>
      <p>
        خیر. رفیرو یک راهنمای مستقل برای پیدا کردن کدهای دعوت است و وابستگی رسمی به طلاسی ندارد.
        برای دیدن کدهای سایر پلتفرم‌ها به <a href="/codes/">فهرست کدهای معرف</a> مراجعه کن.
      </p>
    </section>

    <section class="related-pages" aria-label="کدهای معرف مرتبط">
      <h2>سایر کدهای معرف در رفیرو</h2>
      <p>کدهای دعوت پلتفرم‌های دیگر را هم بررسی کنید:</p>
      <nav aria-label="صفحات مرتبط">
        <a href="/codes/">همه کدهای دعوت</a>
        <a href="/taline/">کد دعوت طلاین</a>
        <a href="/zarpin/">کد دعوت زرپین</a>
        <a href="/melligold/">کد دعوت ملی گلد</a>
        <a href="/blubank/">کد دعوت بلوبانک</a>
        <a href="/wepod/">کد دعوت ویپاد</a>
        <a href="/guide/kod-davat/">راهنمای کد دعوت</a>
        <a href="/about/">درباره رفیرو</a>
      </nav>
    </section>

  </main>


  <style>
    :global(body) {
      background:
        radial-gradient(ellipse at 50% 0%, #292315 0%, transparent 36rem),
        #101110;
    }

    .result {
      padding: 28px 0 64px;
      max-width: 680px;
    }

    .back {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      margin-bottom: 26px;
      padding: 10px 16px;
      border: 1px solid #554728;
      border-radius: 12px;
      background: linear-gradient(135deg, #242116, #191a15);
      color: #e2bd63;
      font-size: 13px;
      font-weight: 800;
      text-decoration: none;
      box-shadow: 0 5px 18px #00000020;
      transition: background .2s ease, border-color .2s ease, transform .2s ease;
    }

    .back:hover {
      border-color: #b89a4f;
      background: linear-gradient(135deg, #332b19, #211f16);
      color: #f0d486;
      transform: translateY(-2px);
    }

    .back:focus-visible {
      outline: 2px solid #e2bd63;
      outline-offset: 3px;
    }

    .intro {
      margin-bottom: 25px;
    }

    .eyebrow {
      display: inline-block;
      padding: 5px 11px;
      border: 1px solid #554728;
      border-radius: 999px;
      background: #211e15;
      color: #e2bd63;
      font-size: 11px;
    }

    .page-title {
      margin: 12px 0 5px;
      color: #f4f1e8;
      font-size: clamp(26px, 5vw, 35px);
      font-weight: 900;
      line-height: 1.6;
    }

    .page-desc {
      margin: 0;
      color: #aaa99f;
      font-size: 13px;
      line-height: 2;
    }

    .card {
      padding: 24px;
      border: 1px solid #39382f;
      border-radius: 22px;
      background:
        radial-gradient(ellipse at top right, #282315 0%, transparent 50%),
        linear-gradient(145deg, #1b1c18, #141512);
      box-shadow: 0 18px 50px #00000020;
    }

    .card-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 23px;
    }

    .platform {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }

    .mark {
      width: 48px;
      height: 48px;
      flex: 0 0 48px;
      display: grid;
      place-items: center;
      border: 1px solid #6a572b;
      border-radius: 15px;
      background: linear-gradient(145deg, #39301b, #252318);
      color: #f0cf7b;
      font-size: 23px;
      font-weight: 900;
      object-fit: contain;
      padding: 4px;
      
    }

    .platform-name {
      color: #f4f1e8;
      font-size: 18px;
      font-weight: 900;
    }

    .platform-caption {
      color: #929188;
      font-size: 11px;
    }

    .status {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
      color: #a8d88a;
      font-size: 11px;
    }

    .status span {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #91cb70;
    }

    .reward {
      margin: 0 0 24px;
      padding: 18px;
      border: 1px solid #554728;
      border-radius: 16px;
      background: linear-gradient(135deg, #282315, #191812);
    }

    .reward-label {
      color: #bdc8ad;
      font-size: 12px;
    }

    .reward-amount {
      margin: 6px 0 8px;
      color: #e2bd63;
      font-size: clamp(23px, 4.6vw, 29px);
      font-weight: 950;
    }

    .reward p {
      margin: 0;
      color: #b5b9aa;
      font-size: 12px;
      line-height: 2;
    }

    .label {
      margin-bottom: 9px;
      color: #aaa99f;
      font-size: 12px;
    }

    .code-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 14px;
      border: 1px dashed #77643a;
      border-radius: 13px;
      background: #11120f;
      direction: ltr;
    }

    .code {
      min-width: 0;
      overflow-wrap: anywhere;
      color: #e2bd63;
      font: 900 clamp(20px, 5vw, 25px)/1.4 ui-monospace, Consolas, monospace;
      letter-spacing: 1.5px;
    }

    .copy {
      flex-shrink: 0;
      padding: 9px 13px;
      border: 1px solid #6f5b2e;
      border-radius: 10px;
      background: #302a1b;
      color: #f0cf7b;
      font: inherit;
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      transition: background .2s ease, border-color .2s ease;
    }

    .copy:hover {
      border-color: #d1ad56;
      background: #40351e;
    }

    .copy-feedback {
      min-height: 22px;
      margin: 5px 0 0;
      color: #a8d88a;
      font-size: 11px;
    }

    .primary {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      min-height: 50px;
      margin-top: 4px;
      padding: 12px 16px;
      border-radius: 12px;
      background: linear-gradient(135deg, #f0d486, #d6ad4d);
      color: #17150f;
      font-size: 13px;
      font-weight: 900;
      text-align: center;
      text-decoration: none;
      transition: filter .2s ease, transform .2s ease;
    }

    .primary:hover {
      filter: brightness(1.07);
      transform: translateY(-1px);
    }

    .steps {
      margin-top: 27px;
      padding-top: 22px;
      border-top: 1px solid #34352e;
    }

    .steps h2 {
      margin: 0 0 12px;
      color: #f4f1e8;
      font-size: 15px;
      font-weight: 900;
    }

    .steps ol {
      margin: 0;
      padding-right: 20px;
      color: #c0bfb4;
      font-size: 12px;
      line-height: 2.3;
    }

    .note {
      margin: 23px 0 0;
      padding-top: 15px;
      border-top: 1px solid #30312c;
      color: #929188;
      font-size: 11px;
      line-height: 2;
    }

    .footer-inner {
      min-height: 75px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
    }

    .footer-brand {
      color: #e2bd63;
      font-size: 20px;
      font-weight: 950;
      letter-spacing: -.6px;
      text-decoration: none;
      direction: ltr;
    }

    .footer-inner > span {
      color: #85857c;
      font-size: 11px;
    }

    @media (max-width: 480px) {
      .result {
        padding-top: 20px;
      }

      .card {
        padding: 17px;
        border-radius: 18px;
      }

      .reward {
        padding: 15px;
      }

      .status {
        font-size: 10px;
      }

      .footer-inner {
        min-height: 70px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .primary,
      .copy {
        transition: none;
      }
    }


  .related-pages {
    margin: 2rem 0;
    padding: 1.25rem;
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 14px;
  }
  .related-pages h2 {
    font-size: 1.15rem;
    margin: 0 0 .65rem;
  }
  .related-pages p {
    margin: 0 0 .9rem;
  }
  .related-pages nav {
    display: flex;
    flex-wrap: wrap;
    gap: .7rem;
  }
  .related-pages nav a {
    text-decoration: none;
  }



    /* Coupon-detail layout inspired by the reference page */
    .result { width: min(820px, calc(100% - 32px)); padding-top: 22px; }
    .breadcrumbs { margin-bottom: 24px; }
    .intro { margin: 0 0 22px; padding: 22px 24px; border: 1px solid #38372e; border-radius: 18px; background: linear-gradient(125deg, #211f17, #171814); }
    .page-title { margin: 0 0 7px; font-size: clamp(25px, 4vw, 34px); line-height: 1.65; }
    .page-desc { margin: 0; max-width: 650px; line-height: 2.1; }
    .card { position: relative; overflow: hidden; padding: 0; border: 1px solid #5a4a2b; border-radius: 20px; background: #171814; box-shadow: 0 18px 48px #0000002b; }
    .card-head { margin: 0; padding: 22px 24px; border-bottom: 1px solid #38372e; background: linear-gradient(110deg, #242116, #191a16); }
    .platform { gap: 13px; }
    .platform-name { color: #f4f1e8; font-size: 19px; font-weight: 900; }
    .platform-caption { margin-top: 2px; color: #aaa99f; font-size: 12px; }
    .mark { width: 52px; height: 52px; flex: 0 0 52px; border: 1px solid #6a572b; border-radius: 15px; background: #fff; object-fit: contain; padding: 5px; }
    .reward { position: relative; margin: 0; padding: 24px; border: 0; border-bottom: 1px dashed #62502b; border-radius: 0; background: radial-gradient(ellipse at top right, #302719, transparent 70%), #1d1c16; text-align: center; }
    .reward::after, .reward::before { content: ""; position: absolute; bottom: -10px; width: 19px; height: 19px; border-radius: 50%; background: #101110; border: 1px solid #5a4a2b; }
    .reward::before { right: -10px; border-right: 0; border-bottom: 0; }
    .reward::after { left: -10px; border-left: 0; border-bottom: 0; }
    .reward-amount { margin: 0; color: #f0cf7b; font-size: clamp(27px, 5vw, 36px); font-weight: 950; line-height: 1.6; }
    .label { margin: 22px 24px 9px; font-size: 12px; font-weight: 700; }
    .code-row { margin: 0 24px; padding: 13px 15px; border: 1px dashed #8c713a; border-radius: 12px; background: #10110f; }
    .code { font-size: clamp(21px, 4vw, 27px); }
    .copy { padding: 10px 15px; }
    .copy-feedback { margin: 5px 24px 0; }
    .primary { width: calc(100% - 48px); min-height: 52px; margin: 13px 24px 0; border-radius: 12px; font-size: 14px; }
    .steps { margin: 23px 24px 0; padding-top: 20px; }
    .steps h2 { font-size: 16px; }
    .steps ol { font-size: 13px; }
    .note, .disclaimer { margin: 22px 24px 0; padding: 15px 0 22px; border-top: 1px solid #30312c; }
    .seo-content { margin-top: 24px; }
    @media (max-width: 520px) {
      .result { width: min(100% - 22px, 820px); padding-top: 16px; }
      .intro { padding: 16px; margin-bottom: 15px; }
      .card-head { padding: 17px 16px; }
      .mark { width: 46px; height: 46px; flex-basis: 46px; }
      .reward { padding: 21px 14px; }
      .label { margin: 20px 16px 8px; }
      .code-row { margin: 0 16px; padding: 10px; gap: 8px; }
      .copy { padding: 8px 10px; font-size: 11px; }
      .copy-feedback { margin-inline: 16px; }
      .primary { width: calc(100% - 32px); margin-inline: 16px; font-size: 12px; }
      .steps { margin-inline: 16px; }
      .note, .disclaimer { margin-inline: 16px; }
    }

  </style>

  <script>
    const copyButton = document.querySelector('#copyCode');
    const codeElement = document.querySelector('#inviteCode');
    const feedback = document.querySelector('#copyFeedback');

    copyButton?.addEventListener('click', async () => {
      const code = codeElement?.textContent?.trim();

      if (!code) return;

      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(code);
        } else {
          const textarea = document.createElement('textarea');
          textarea.value = code;
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';
          document.body.appendChild(textarea);
          textarea.select();

          const copied = document.execCommand('copy');
          textarea.remove();

          if (!copied) throw new Error('Copy failed');
        }

        copyButton.textContent = 'کپی شد ✓';
        feedback.textContent = 'کد دعوت کپی شد؛ حالا می‌تونی از لینک ثبت‌نام استفاده کنی.';
      } catch {
        feedback.textContent = 'کپی خودکار انجام نشد؛ کد yZfgvrdj رو دستی کپی کن.';
      }

      window.setTimeout(() => {
        copyButton.textContent = 'کپی کد';
      }, 1800);
    });
  </script>
  <Footer />
</body>
</html>
