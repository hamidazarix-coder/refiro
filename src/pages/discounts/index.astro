---
import '../../styles/global.css';
import { discounts } from '../../data/discounts.js';
const title = 'کدهای تخفیف فروشگاه‌ها و سرویس‌ها | رفیرو';
const description = 'فهرست کدهای تخفیف فروشگاه‌ها، خدمات آنلاین، سفر و آموزش در رفیرو؛ کد را کپی کن و پیش از خرید اعتبار آن را بررسی کن.';
---
<!doctype html>
<html lang="fa" dir="rtl">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="theme-color" content="#101110" /><link rel="canonical" href="https://refiro.ir/discounts/" /><link rel="icon" type="image/png" href="/favicon.png" sizes="128x128" /><title>{title}</title></head>
<body>
<header class="site-header"><div class="site-header-inner"><a class="site-brand" href="/" aria-label="رفیرو، صفحه اصلی"><span class="site-brand-mark">R</span><span class="site-brand-word">رفیرو</span></a><nav class="site-nav" aria-label="ناوبری اصلی"><a href="/codes/">کدهای دعوت</a><a href="/discounts/" aria-current="page">کدهای تخفیف</a><a href="/#searchForm">جست‌وجو</a></nav></div></header>
<main class="wrap discount-page">
<nav class="breadcrumbs" aria-label="مسیر صفحه"><a href="/">صفحه اصلی</a><span>/</span><span aria-current="page">کدهای تخفیف</span></nav>
<span class="discount-eyebrow">پیشنهادهای خرید</span><h1 class="page-title">کدهای تخفیف</h1><p class="page-desc">کدهای تخفیف فروشگاه‌ها و سرویس‌ها را پیدا کن. اعتبار این کدها ممکن است تغییر کند؛ پیش از پرداخت، آن‌ها را در فروشگاه یا منبع پیشنهاد بررسی کن.</p>
<label class="discount-search"><span class="sr-only">جست‌وجوی تخفیف</span><input id="discountSearch" type="search" placeholder="نام فروشگاه، دسته یا کد تخفیف..." autocomplete="off" /></label>
<div class="discount-grid" id="discountGrid">{discounts.map((item) => <article class="discount-card" data-search={`${item.title} ${item.store} ${item.code} ${item.category} ${item.value}`}><div class="discount-card-top"><span class="discount-symbol">%</span><span class="discount-status">اعتبار بررسی‌نشده</span></div><p class="discount-category">{item.category}</p><h2><a href={`/discounts/${item.slug}/`}>{item.title}</a></h2><p class="discount-value">{item.value}</p><p class="discount-summary">{item.summary}</p><div class="discount-card-bottom"><span>{item.store}</span><a href={`/discounts/${item.slug}/`}>مشاهده کد ←</a></div></article>)}</div>
<p id="discountEmpty" class="empty" hidden>تخفیفی با این عبارت پیدا نشد.</p><p class="discount-source-note">این فهرست اولیه است؛ رفیرو مستقل از فروشگاه‌ها و وب‌سایت‌های منبع است. کدها از نظر فعال‌بودن تضمین نشده‌اند و برای هر پیشنهاد، لینک منبع در صفحه جزئیات قرار دارد.</p>
</main><footer class="foot"><div class="wrap footer-inner"><a class="footer-brand" href="/">رفیرو</a><nav class="footer-links"><a href="/codes/">کدهای دعوت</a><a href="/discounts/">کدهای تخفیف</a><a href="/about/">درباره رفیرو</a></nav></div></footer>
<style>
.discount-page{padding:30px 0 64px}.discount-eyebrow{display:inline-block;padding:5px 11px;border:1px solid #554728;border-radius:999px;background:#211e15;color:#e2bd63;font-size:12px}.discount-page>.page-title{margin:12px 0 5px;font-size:clamp(28px,5vw,38px)}.discount-page>.page-desc{margin:0 0 22px;color:#aaa99f;font-size:13px;line-height:2}.discount-search{display:block;margin-bottom:20px}.discount-search input{width:100%;padding:14px 16px;border:1px solid #454235;border-radius:13px;background:#191a17;color:#f4f1e8;font:inherit;outline:none}.discount-search input:focus{border-color:#b79a52}.discount-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:15px}.discount-card{display:flex;flex-direction:column;min-height:260px;padding:19px;border:1px solid #39372e;border-radius:17px;background:linear-gradient(145deg,#1b1c18,#141512);transition:transform .18s,border-color .18s}.discount-card:hover{transform:translateY(-3px);border-color:#78602d}.discount-card-top{display:flex;align-items:center;justify-content:space-between;gap:8px}.discount-symbol{display:grid;place-items:center;width:40px;height:40px;border-radius:12px;background:#302a1b;color:#e2bd63;font-size:24px;font-weight:900}.discount-status{padding:4px 8px;border:1px solid #62502b;border-radius:999px;color:#d9bc79;font-size:10px}.discount-category{margin:13px 0 4px;color:#aaa99f;font-size:11px}.discount-card h2{margin:0;font-size:17px;line-height:1.8}.discount-card h2 a{color:#f4f1e8;text-decoration:none}.discount-value{margin:9px 0;color:#e2bd63;font-weight:900;font-size:15px}.discount-summary{margin:0 0 16px;color:#aaa99f;font-size:12px;line-height:2}.discount-card-bottom{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:auto;padding-top:12px;border-top:1px solid #30312c;color:#aaa99f;font-size:11px}.discount-card-bottom a{color:#e2bd63;text-decoration:none;font-weight:800}.discount-source-note{margin:24px 0 0;padding:14px 16px;border-right:3px solid #8d7138;background:#1a1914;color:#aaa99f;font-size:12px;line-height:2}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}[hidden]{display:none!important}@media(max-width:480px){.discount-page{padding-top:22px}.discount-card{min-height:0}}
</style>
<script>
const normalize = (value = '') => value.toLocaleLowerCase('fa').replace(/ي/g, 'ی').replace(/ك/g, 'ک').replace(/‌/g, '').replace(/\s+/g, '').trim();
const input = document.querySelector('#discountSearch'); const cards = [...document.querySelectorAll('.discount-card')]; const empty = document.querySelector('#discountEmpty');
input?.addEventListener('input', () => { const query = normalize(input.value); cards.forEach((card) => { card.hidden = query !== '' && !normalize(card.dataset.search || '').includes(query); }); if (empty) empty.hidden = cards.some((card) => !card.hidden); });
</script></body></html>
