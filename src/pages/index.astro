    @media(prefers-reduced-motion:reduce){.promo-slide.ad-slide{transition:none}}
  </style>
  <script>
    import { platforms } from '../data/platforms.js';
    const typewriter = document.querySelector('#heroTypewriter');
    const phrases = [
      'بزرگ‌ترین مرجع کد تخفیف و دعوت در ایران',
      'به جیب بزن!',
      'جدیدترین کد های تخفیف در رفیرو',
      'کد دعوت می‌خوای؟ داریمش!',
      'کدتخفیفم؟! اونم داریم'
    ];
    if (typewriter && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let phraseIndex = 0;
      let charIndex = phrases[0].length;
      let deleting = false;
      const typeNext = () => {
        const currentPhrase = phrases[phraseIndex];
        if (!deleting) {
          if (charIndex < currentPhrase.length) {
            charIndex++;
            typewriter.textContent = currentPhrase.slice(0, charIndex);
            window.setTimeout(typeNext, 65);
          } else {
            deleting = true;
            window.setTimeout(typeNext, 3000);
          }
          return;
        }
        if (charIndex > 0) {
          charIndex--;
          typewriter.textContent = currentPhrase.slice(0, charIndex);
          window.setTimeout(typeNext, 35);
        } else {
          phraseIndex = (phraseIndex + 1) % phrases.length;
          deleting = false;
          charIndex = 0;
          window.setTimeout(typeNext, 450);
        }
      };
      window.setTimeout(typeNext, 3000);
    }
    const track = document.querySelector('#promoTrack');
    const slides = [...document.querySelectorAll('.promo-slide')];
    let index = 0;
    function showSlide(next) {
      if (!slides.length) return;
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => slide.setAttribute('aria-hidden', String(i !== index)));
    }
    if (slides.length > 1) {
      // Rotate through welcome, ad placement, and earning messages every five seconds.
      setInterval(() => showSlide(index + 1), 5000);
    }

        const form = document.querySelector('#searchForm');
    const input = document.querySelector('#searchInput');
    const cards = [...document.querySelectorAll('.platform-card[data-name]')];
    const noResult = document.querySelector('#noResult');
    const initialQuery = new URLSearchParams(window.location.search).get('q') || '';
    if (input && initialQuery) input.value = initialQuery;
    const normalize = (value = '') => value.toLocaleLowerCase('fa').replace(/ي/g,'ی').replace(/ك/g,'ک').replace(/‌/g,'').replace(/\s+/g,'').trim();
    function findPlatform(query) {
      const q = normalize(query);
      if (!q) return null;
      return platforms.find((p) => [p.name,p.id,p.code,...(p.aliases || [])].some((v) => normalize(v) === q || normalize(v).includes(q))) || null;
    }
    function updateResults() {
      const q = normalize(input?.value || '');
      const matched = q ? findPlatform(q) : null;
      cards.forEach((card) => card.classList.toggle('hidden', !!q && !(normalize(card.dataset.name || '').includes(q) || (matched && card.getAttribute('href') === matched.href))));
      noResult?.classList.toggle('hidden', !q || cards.every((card) => card.classList.contains('hidden')));
    }
    input?.addEventListener('input', updateResults);
    if (initialQuery) updateResults();
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const query = input?.value.trim() || '';
      if (!query) return;
      const p = findPlatform(query);
      if (p) window.location.href = p.href;
      else { updateResults(); document.querySelector('#platforms')?.scrollIntoView({behavior:'smooth',block:'start'}); }
    });
  </script>
