---
import '../styles/global.css';
import { platforms } from '../data/platforms.js';

const title = 'کد دعوت و کد معرف معتبر | رفیرو';
const description = 'کد دعوت طلاین، زرپین، ملی گلد، طلاسی، بلوبانک و ویپاد را در رفیرو پیدا کن؛ کد را کپی کن یا مستقیم وارد لینک ثبت‌نام شو.';
const activePlatforms = platforms.filter((platform) => platform.active);
---

<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#f8f7f2" />
  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem('refiro-theme');
        document.documentElement.dataset.theme = saved === 'dark' ? 'dark' : 'light';
      } catch { document.documentElement.dataset.theme = 'light'; }
    })();
  </script>
  <link rel="canonical" href="https://refiro.ir/" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
  <link rel="preload" href="/fonts/iranian-sans.ttf" as="font" type="font/ttf" crossorigin />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <meta property="og:locale" content="fa_IR" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="رفیرو" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://refiro.ir/" />
  <meta property="og:image" content="https://refiro.ir/og-cover.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://refiro.ir/og-cover.png" />
  <title>{title}</title>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "https://refiro.ir/#website",
        "name": "رفیرو",
        "alternateName": "Refiro",
        "url": "https://refiro.ir/",
        "inLanguage": "fa-IR",
        "description": description
      },
      {
        "@type": "Organization",
        "@id": "https://refiro.ir/#organization",
        "name": "رفیرو",
        "alternateName": "Refiro",
        "url": "https://refiro.ir/",
        "logo": "https://refiro.ir/refiro-logo.bmp"
      }
    ]
  })} />
</head>
<body>
  <div class="announcement">
    <span class="announcement-dot" aria-hidden="true"></span>
    کدهای دعوت و معرف را یک‌جا پیدا کن
    <a href="/codes/">مشاهده همه کدها <span aria-hidden="true">←</span></a>
  </div>

  <header class="site-header">
    <div class="site-header-inner">
      <a class="site-brand" href="/" aria-label="رفیرو، صفحه اصلی">
        <span class="site-brand-mark">R</span>
        <span class="site-brand-word">رفیرو</span>
      </a>
      <nav class="site-nav" aria-label="ناوبری اصلی">
        <a href="/" aria-current="page">خانه</a>
        <a href="#platforms">کدهای دعوت</a>
        <a href="/codes/">همه کدها</a>
        <a href="/guide/kod-davat/">راهنمای استفاده</a>
      </nav>
      <div class="header-actions"><button class="theme-toggle" id="themeToggle" type="button" aria-label="فعال‌کردن حالت تاریک" title="حالت تاریک"><svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path></svg><svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.9 13A8.5 8.5 0 0 1 11 3.1 8.5 8.5 0 1 0 20.9 13Z"></path></svg></button><a class="header-cta" href="#searchForm">پیدا کردن کد <span aria-hidden="true">←</span></a></div>
    </div>
  </header>

  <main>
    <section class="hero wrap">
      <div class="hero-copy">
        <span class="eyebrow"><span aria-hidden="true">✦</span> شروع هوشمندانه‌تر</span>
        <h1>کد دعوتت رو پیدا کن،<br /><span>هدیه‌ات رو از دست نده!</span></h1>
        <p class="hero-description">کدهای معرف پلتفرم‌های محبوب طلا و خدمات مالی رو در رفیرو پیدا کن؛ کد رو کپی کن یا مستقیم از لینک دعوت وارد شو.</p>
        <form class="search" id="searchForm" role="search">
          <span class="search-icon" aria-hidden="true">⌕</span>
          <input id="searchInput" type="search" placeholder="جست‌وجوی نام پلتفرم؛ مثلاً طلاین" aria-label="جست‌وجوی کد دعوت" autocomplete="off" />
          <button type="submit">جست‌وجو <span aria-hidden="true">←</span></button>
        </form>
        <p class="search-hint">نام پلتفرم رو فارسی یا انگلیسی وارد کن.</p>
        <div class="hero-trust">
          <span><span class="trust-check">✓</span> دسترسی سریع به کدها</span>
          <span><span class="trust-check">✓</span> لینک مستقیم ثبت‌نام</span>
          <span><span class="trust-check">✓</span> رایگان و ساده</span>
        </div>
      </div>
      <div class="hero-art" aria-label="نمونه کارت کد دعوت رفیرو">
        <div class="art-glow"></div>
        <div class="floating-chip chip-top"><span class="chip-icon">✦</span><span><b>کدهای دعوت</b><small>همه در یک جا</small></span></div>
        <div class="invite-card">
          <div class="invite-card-head"><span class="mini-brand"><span>R</span> رفیرو</span><span class="live-pill"><i></i> در دسترس</span></div>
          <div class="invite-card-label">کد دعوت تو آماده‌ست</div>
          <div class="invite-card-code" dir="ltr">YOUR CODE</div>
          <div class="invite-card-line"></div>
          <div class="invite-card-bottom"><span>کپی کن و ادامه بده</span><span class="copy-symbol">▣</span></div>
        </div>
        <div class="floating-chip chip-bottom"><span class="coin-symbol">✧</span><span><b>شروع راحت‌تر</b><small>با چند کلیک ساده</small></span></div>
      </div>
    </section>

    <section class="platform-section wrap" id="platforms" aria-labelledby="platformTitle">
      <div class="section-heading">
        <div>
          <span class="section-kicker">انتخاب با توئه</span>
          <h2 id="platformTitle">کدهای دعوت پرطرفدار</h2>
          <p>پلتفرمت رو انتخاب کن و جزئیات کد رو ببین.</p>
        </div>
        <a class="section-link" href="/codes/">مشاهده همه <span aria-hidden="true">←</span></a>
      </div>

      <div class="platform-grid" id="platformGrid">
        {activePlatforms.map((platform) => (
          <a class="platform-card" href={platform.href} data-name={platform.name} data-active="true">
            <div class="platform-card-top">
              <div class="platform-logo">
                {platform.image ? (
                  <img src={platform.image} alt="" width="48" height="48" loading="lazy" decoding="async" />
                ) : (
                  <span>{platform.mark}</span>
                )}
              </div>
              <span class="card-status"><i></i> فعال</span>
            </div>
            <h3>کد دعوت {platform.name}</h3>
            <p class="platform-card-desc">کد معرف {platform.name} و لینک ورود مستقیم رو ببین.</p>
            <div class="platform-card-bottom">
              <span class="reward-label">پاداش / طرح معرفی</span>
              <span class="reward-value">{platform.reward}</span>
            </div>
            <div class="card-action">مشاهده کد <span aria-hidden="true">←</span></div>
          </a>
        ))}
      </div>
      <p class="empty hidden" id="noResult" role="status">پلتفرمی با این نام پیدا نشد. نام دیگری رو امتحان کن.</p>
      <div class="all-platforms-cta"><a href="/codes/">دیدن فهرست کامل کدهای دعوت <span aria-hidden="true">←</span></a></div>
    </section>





    <section class="faq-section wrap" aria-labelledby="faqTitle">
      <div class="faq-heading">
        <span class="section-kicker">سؤالات متداول</span>
        <h2 id="faqTitle">قبل از استفاده از کد دعوت</h2>
      </div>
      <div class="faq-list">
        <details><summary>رفیرو دقیقاً چیکار می‌کنه؟ <span>＋</span></summary><p>رفیرو بهت کمک می‌کنه کد دعوت یا معرف سرویس موردنظرت رو پیدا کنی؛ بعد می‌تونی کد رو برداری یا از لینک ثبت‌نام وارد بشی.</p></details>
        <details><summary>کد دعوت با کد معرف چه فرقی داره؟ <span>＋</span></summary><p>در خیلی از سرویس‌ها این دو عبارت برای یک کاربرد استفاده می‌شن: کدی که موقع ثبت‌نام برای معرفی کاربر جدید وارد می‌شه. نام و محل واردکردن کد ممکنه در هر سرویس متفاوت باشه.</p></details>
        <details><summary>دریافت هدیه با کد دعوت تضمینیه؟ <span>＋</span></summary><p>نه لزوماً. پاداش و شرایط طرح‌ها ممکنه تغییر کنه و معمولاً به ضوابط همون سرویس بستگی داره. قبل از ثبت‌نام، شرایط روز رو در سایت یا اپلیکیشن رسمی بررسی کن.</p></details>
        <details><summary>رفیرو سایت رسمی پلتفرم‌هاست؟ <span>＋</span></summary><p>خیر؛ رفیرو یک راهنمای مستقل برای پیدا کردن کدهای دعوت است. ثبت‌نام و بررسی شرایط نهایی از طریق منابع رسمی هر پلتفرم انجام می‌شه.</p></details>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-main wrap">
      <div class="footer-about">
        <a class="footer-logo" href="/"><span class="site-brand-mark">R</span><span>رفیرو</span></a>
        <p>مرجع ساده کدهای دعوت و معرف؛ پلتفرمت رو پیدا کن و مستقیم وارد شو.</p>
      </div>
      <div class="footer-column"><h2>دسترسی سریع</h2><a href="/">خانه</a><a href="/codes/">همه کدها</a><a href="/guide/kod-davat/">راهنمای کد دعوت</a></div>
      <div class="footer-column"><h2>درباره رفیرو</h2><a href="/about/">درباره ما</a><a href="/#faqTitle">سؤالات متداول</a></div>
    </div>
    <div class="footer-bottom"><div class="wrap footer-bottom-inner"><span>© رفیرو — استفاده از کدها رایگان است.</span><span>ثبت‌نام و پاداش‌ها تابع شرایط رسمی هر پلتفرم‌اند.</span></div></div>
  </footer>

  <style>
    :global(html){scroll-behavior:smooth;scroll-padding-top:90px}
    :global(body){background:#101110;color:#f4f1e8;overflow-x:hidden}
    :global(.wrap){width:min(1120px,calc(100% - 40px));margin-inline:auto}
    .announcement{min-height:36px;display:flex;align-items:center;justify-content:center;gap:9px;padding:7px 16px;background:#242116;border-bottom:1px solid #3c3422;color:#d5c49a;font-size:11px;text-align:center}
    .announcement-dot{width:6px;height:6px;border-radius:50%;background:#e2bd63;box-shadow:0 0 10px #e2bd6370}
    .announcement a{color:#f0cf7b;text-decoration:none;font-weight:800;margin-right:5px}
    .site-header{position:sticky;top:0;z-index:20;border-bottom:1px solid #30312c;background:#101110ed;backdrop-filter:blur(16px)}
    .site-header-inner{width:min(1200px,calc(100% - 40px));min-height:78px;margin:auto;display:flex;align-items:center;gap:28px}
    .site-brand,.footer-logo{display:inline-flex;align-items:center;gap:10px;flex-shrink:0;text-decoration:none}
    .site-brand-mark{width:39px;height:39px;display:grid;place-items:center;border:1px solid #78602d;border-radius:12px;background:linear-gradient(145deg,#f0d486,#c59a3b);color:#17150f;font:950 23px/1 Arial,sans-serif;direction:ltr;box-shadow:0 4px 14px #e2bd631b}
    .site-brand-word{color:#f0cf7b;font-size:25px;font-weight:950;letter-spacing:-.6px}
    .site-nav{display:flex;align-items:center;justify-content:center;gap:5px;flex:1}
    .site-nav a{padding:9px 12px;border-radius:9px;color:#c2c0b5;font-size:12px;font-weight:700;text-decoration:none;white-space:nowrap;transition:background .2s,color .2s}
    .site-nav a:hover,.site-nav a[aria-current=page]{background:#211f17;color:#f0cf7b}
    .header-cta{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:10px 15px;border:1px solid #78602d;border-radius:10px;background:#e2bd63;color:#17150f;font-size:12px;font-weight:900;text-decoration:none;white-space:nowrap;transition:filter .2s,transform .2s}
    .header-cta:hover{filter:brightness(1.08);transform:translateY(-1px)}
    .hero{position:relative;display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:65px;padding-top:78px;padding-bottom:88px}
    .hero-copy{position:relative;z-index:1}
    .eyebrow,.section-kicker{display:inline-flex;align-items:center;gap:7px;color:#d9bc79;font-size:12px;font-weight:850}
    .eyebrow{padding:7px 12px;border:1px solid #514327;border-radius:999px;background:#191810}
    .hero h1{margin:20px 0 15px;font-size:clamp(34px,4.2vw,54px);font-weight:950;line-height:1.55;letter-spacing:-1.1px}
    .hero h1 span{color:#e2bd63}
    .hero-description{max-width:600px;margin:0 0 23px;color:#aaa99f;font-size:14px;line-height:2.2}
    .search{display:flex;align-items:center;gap:9px;max-width:590px;padding:7px;border:1px solid #454235;border-radius:15px;background:#191a17;box-shadow:0 12px 34px #00000020;transition:border-color .2s,box-shadow .2s}
    .search:focus-within{border-color:#b79a52;box-shadow:0 0 0 3px #e2bd6312}
    .search-icon{padding-inline:8px;color:#d9bc79;font-size:25px;line-height:1}
    .search input{flex:1;min-width:0;padding:10px 4px;border:0;outline:0;background:transparent;color:#f4f1e8;font:inherit;font-size:13px}
    .search input::placeholder{color:#85857c}
    .search button{display:inline-flex;align-items:center;justify-content:center;gap:8px;flex-shrink:0;padding:11px 17px;border:0;border-radius:10px;background:linear-gradient(135deg,#f0d486,#d6ad4d);color:#17150f;font:inherit;font-size:12px;font-weight:950;cursor:pointer}
    .search-hint{margin:8px 0 0;color:#85857c;font-size:11px}
    .hero-trust{display:flex;flex-wrap:wrap;gap:17px;margin-top:24px}
    .hero-trust span{display:inline-flex;align-items:center;gap:6px;color:#b9b7ac;font-size:11px}
    .trust-check{display:grid;place-items:center;width:17px;height:17px;border:1px solid #365a42;border-radius:50%;color:#70d89d;font-size:10px}
    .hero-art{position:relative;min-height:365px;display:grid;place-items:center;isolation:isolate}
    .art-glow{position:absolute;z-index:-1;width:330px;height:330px;border-radius:50%;background:#b88d3030;filter:blur(65px)}
    .invite-card{position:relative;width:min(100%,355px);padding:24px;border:1px solid #66532d;border-radius:23px;background:linear-gradient(145deg,#242218,#171814 70%);box-shadow:0 28px 70px #00000055;transform:rotate(-3deg)}
    .invite-card:before{content:"";position:absolute;inset:0 20% auto;height:1px;background:linear-gradient(90deg,transparent,#f0cf7b,transparent)}
    .invite-card-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding-bottom:20px;border-bottom:1px solid #38372e}
    .mini-brand{display:flex;align-items:center;gap:8px;color:#f0cf7b;font-size:13px;font-weight:900}
    .mini-brand>span{display:grid;place-items:center;width:27px;height:27px;border-radius:8px;background:#e2bd63;color:#17150f;font:bold 17px Arial}
    .live-pill{display:flex;align-items:center;gap:6px;padding:5px 9px;border:1px solid #24583e;border-radius:99px;background:#14231a;color:#70d89d;font-size:10px}
    .live-pill i,.card-status i{width:6px;height:6px;border-radius:50%;background:#53d68e}
    .invite-card-label{margin-top:24px;color:#aaa99f;font-size:12px}
    .invite-card-code{margin:8px 0 16px;color:#f0cf7b;font:900 30px/1.5 ui-monospace,Consolas,monospace;letter-spacing:2px}
    .invite-card-line{height:1px;background:repeating-linear-gradient(90deg,#655332 0 5px,transparent 5px 10px)}
    .invite-card-bottom{display:flex;align-items:center;justify-content:space-between;margin-top:16px;color:#c7c2b2;font-size:11px}
    .copy-symbol{display:grid;place-items:center;width:31px;height:31px;border:1px solid #6f5b2e;border-radius:9px;color:#f0cf7b;font-size:17px}
    .floating-chip{position:absolute;z-index:2;display:flex;align-items:center;gap:10px;padding:12px 15px;border:1px solid #414033;border-radius:14px;background:#1b1c18ed;box-shadow:0 15px 35px #00000035;backdrop-filter:blur(8px)}
    .floating-chip b,.floating-chip small{display:block}
    .floating-chip b{color:#eee8d8;font-size:11px}
    .floating-chip small{margin-top:2px;color:#99988e;font-size:10px}
    .chip-icon,.coin-symbol{display:grid;place-items:center;width:34px;height:34px;border:1px solid #5e4d2a;border-radius:10px;background:#302819;color:#f0cf7b;font-size:18px}
    .chip-top{top:25px;right:-7px}
    .chip-bottom{bottom:25px;left:-7px}
    .platform-section{padding-top:20px;padding-bottom:85px}
    .section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:22px;margin-bottom:26px}
    .section-heading h2,.how-intro h2,.faq-heading h2{margin:8px 0;color:#f4f1e8;font-size:clamp(23px,3vw,32px);font-weight:950;line-height:1.65}
    .section-heading p{margin:0;color:#99988e;font-size:13px;line-height:2}
    .section-link,.text-link{display:inline-flex;align-items:center;gap:8px;color:#e2bd63;font-size:12px;font-weight:850;text-decoration:none;white-space:nowrap}
    .section-link:hover,.text-link:hover{color:#f0d486}
    .platform-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
    .platform-card{position:relative;display:flex;flex-direction:column;min-width:0;padding:21px;border:1px solid #34372e;border-radius:18px;background:linear-gradient(150deg,#1d1f1a,#151612 80%);color:inherit;text-decoration:none;transition:transform .22s,border-color .22s,box-shadow .22s}
    .platform-card:hover{transform:translateY(-4px);border-color:#8b7139;box-shadow:0 16px 35px #00000026}
    .platform-card:focus-visible,.site-nav a:focus-visible,.header-cta:focus-visible{outline:2px solid #e2bd63;outline-offset:3px}
    .platform-card-top{display:flex;align-items:center;justify-content:space-between;gap:12px}
    .platform-logo{width:49px;height:49px;display:grid;place-items:center;overflow:hidden;border:1px solid #454033;border-radius:14px;background:#f8f7f2;color:#80652c;font-size:20px;font-weight:900}
    .platform-logo img{width:100%;height:100%;padding:5px;object-fit:contain}
    .card-status{display:inline-flex;align-items:center;gap:6px;padding:5px 8px;border:1px solid #28533d;border-radius:99px;background:#14231a;color:#70d89d;font-size:10px;font-weight:800}
    .platform-card h3{margin:17px 0 5px;color:#f4f1e8;font-size:16px;font-weight:900}
    .platform-card-desc{min-height:45px;margin:0;color:#a4a398;font-size:12px;line-height:2}
    .platform-card-bottom{display:flex;flex-direction:column;gap:4px;margin-top:18px;padding-top:14px;border-top:1px solid #30312c}
    .reward-label{color:#85857c;font-size:10px}
    .reward-value{color:#e8c66f;font-size:12px;font-weight:900}
    .card-action{display:flex;align-items:center;justify-content:space-between;margin-top:17px;padding-top:12px;border-top:1px dashed #39382f;color:#d9bc79;font-size:11px;font-weight:900}
    .empty{margin:20px 0;padding:14px;border:1px solid #39352a;border-radius:12px;color:#c6b98f;text-align:center;font-size:13px}
    .hidden{display:none!important}
    .all-platforms-cta{display:flex;justify-content:center;margin-top:27px}
    .all-platforms-cta a{display:inline-flex;align-items:center;gap:10px;padding:12px 17px;border:1px solid #554728;border-radius:11px;color:#e2bd63;font-size:12px;font-weight:850;text-decoration:none;transition:background .2s}
    .all-platforms-cta a:hover{background:#211e15}
    .how-section{padding:76px 0;background:linear-gradient(115deg,#1c1b15,#171814 50%,#1d1d17);border-top:1px solid #302f27;border-bottom:1px solid #302f27}
