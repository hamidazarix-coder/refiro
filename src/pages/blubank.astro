---
import '../styles/global.css';

const code = 'SWHTAI';
const title = 'کد دعوت بلوبانک SWHTAI و هدیه نقدی | رفیرو';
const description = 'کد دعوت بلوبانک SWHTAI را کپی کن و راهنمای استفاده را ببین. مبلغ و شرایط هدیه نقدی را پیش از ثبت‌نام در منبع رسمی بررسی کن.';
---

<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#101110" />
  <link rel="canonical" href="https://refiro.ir/blubank/" />
  <link rel="icon" type="image/png" href="/favicon.png" sizes="128x128" />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <meta property="og:locale" content="fa_IR" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="رفیرو" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://refiro.ir/blubank/" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <title>{title}</title>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "url": "https://refiro.ir/blubank/",
    "description": description,
    "inLanguage": "fa-IR",
    "isPartOf": { "@type": "WebSite", "name": "رفیرو", "url": "https://refiro.ir/" }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "صفحه اصلی", "item": "https://refiro.ir/" },
      { "@type": "ListItem", "position": 2, "name": "همه کدهای معرف", "item": "https://refiro.ir/codes/" },
      { "@type": "ListItem", "position": 3, "name": "کد دعوت بلوبانک", "item": "https://refiro.ir/blubank/" }
    ]
  })} />
</head>
<body>
  <main class="wrap result">
    <nav class="breadcrumbs" aria-label="مسیر صفحه">
      <a href="/">صفحه اصلی</a><span aria-hidden="true">/</span>
      <a href="/codes/">همه کدهای معرف</a><span aria-hidden="true">/</span>
      <span aria-current="page">کد دعوت بلوبانک</span>
    </nav>
    <h1 class="page-title">کد دعوت بلوبانک</h1>
    <p class="page-desc">کد دعوت را کپی کن و هنگام ثبت‌نام در بلوبانک در بخش کد معرف وارد کن.</p>

    <article class="card">
      <div class="card-head">
        <div class="platform">
          <img class="mark-logo mark-logo-blu" src="https://upload.wikimedia.org/wikipedia/commons/b/b6/Blubank_light_logo.svg" alt="لوگوی بلوبانک" width="48" height="48" loading="lazy" />
          <span>بلوبانک</span>
        </div>
        <span class="status">فعال</span>
      </div>

      <section class="reward">
        <div class="reward-amount">۱۵۰ هزار تومان هدیه نقدی</div>
        <p>با وارد کردن این کد دعوت، به‌صورت آنی ۱۵۰ هزار تومان به جیب بزن!</p>
      </section>

      <div class="label">کد دعوت شما</div>
      <div class="code-row">
        <span class="code" id="inviteCode">{code}</span>
        <button class="copy" id="copyCode" type="button">کپی کد</button>
      </div>
      <p id="copyFeedback" class="hint" role="status" aria-live="polite"></p>

      <a class="primary" href="https://blubank.com/download" target="_blank" rel="noopener noreferrer">ورود به وب‌سایت رسمی بلوبانک ↗</a>

      <div class="steps">
        <h2>چطور از کد استفاده کنی؟</h2>
        <ol>
          <li>کد دعوت بالا را کپی کن.</li>
          <li>از وب‌سایت رسمی بلوبانک اپلیکیشن را دریافت و مراحل افتتاح حساب را آغاز کن.</li>
          <li>کد معرف را در مرحله مربوط وارد کن و شرایط طرح هدیه را بررسی کن.</li>
        </ol>
      </div>
      <p class="note">رفیرو یک راهنمای مستقل است و وابستگی رسمی به بلوبانک ندارد. مبلغ و شرایط هدیه ممکن است تغییر کند؛ پیش از ثبت‌نام، شرایط روز طرح را در کانال رسمی بررسی کن.</p>
    </article>

    <section class="seo-content" aria-labelledby="blubank-info-title">
      <h2 id="blubank-info-title">کد دعوت بلوبانک SWHTAI را کجا وارد کنم؟</h2>
      <p>کد SWHTAI را کپی کن و فرایند افتتاح حساب را از وب‌سایت رسمی بلوبانک آغاز کن. اگر در روند ثبت‌نام فیلد کد معرف نمایش داده شد، کد را پیش از تکمیل مراحل وارد کن و پیام تأیید را بررسی کن.</p>
      <h2>هدیه نقدی بلوبانک و شرایط آن</h2>
      <p>مبالغ تبلیغاتی یا شرایط معرفی ممکن است تغییر کنند و دریافت هدیه لزوماً برای همه حساب‌ها یکسان نیست. پیش از افتتاح حساب، مبلغ و ضوابط معتبر را در منبع رسمی بلوبانک بخوان؛ رفیرو یک راهنمای مستقل است و تصمیم نهایی بر اساس شرایط خود سرویس انجام می‌شود.</p>
      <h2>اگر کد معرف بلوبانک کار نکرد چه کنم؟</h2>
      <p>کد را از روی همین صفحه دوباره کپی کن، حروف را تغییر نده و شرایط طرح را بررسی کن. رمز یک‌بارمصرف، رمز بانکی یا اطلاعات حساس را برای دریافت کد دعوت در اختیار افراد دیگر قرار نده.</p>
    </section>
    <section class="related-pages" aria-label="کدهای معرف مرتبط">
      <h2>سایر کدهای معرف در رفیرو</h2>
      <nav aria-label="صفحات مرتبط">
        <a href="/codes/">همه کدهای معرف</a>
        <a href="/about/">درباره رفیرو و روش بررسی کدها</a>
        <a href="/taline/">کد دعوت طلاین</a>
        <a href="/zarpin/">کد دعوت زرپین</a>
        <a href="/melligold/">کد معرف ملی گلد</a>
        <a href="/blubank/">کد دعوت بلوبانک</a>
        <a href="/wepod/">کد دعوت ویپاد</a>
      </nav>
    </section>
  </main>

  <style>
    :global(body) { background: radial-gradient(ellipse at 50% 0%, #292315 0%, transparent 36rem), #101110; }
    .result { max-width: 680px; padding: 28px 0 64px; }
    .back { display:inline-flex; margin-bottom:26px; padding:10px 16px; border:1px solid #554728; border-radius:12px; background:#242116; color:#e2bd63; font-size:13px; font-weight:800; text-decoration:none; }
    .platform { display:flex; align-items:center; gap:12px; font-weight:900; font-size:18px; }
    .mark { display:grid; place-items:center; width:48px; height:48px; border:1px solid #6a572b; border-radius:15px; background:#302a1b; color:#e2bd63; font-weight:900; }
    .mark-logo { width:48px; height:48px; flex:0 0 48px; object-fit:contain; border-radius:12px; background:#fff; padding:5px; }
    .status { color:#39d98a; font-size:12px; font-weight:800; }
    .reward { margin:22px 0; padding:18px; border:1px solid #554728; border-radius:16px; background:linear-gradient(135deg,#282315,#191812); }
    .reward-amount { color:#e2bd63; font-size:clamp(22px,4.5vw,29px); font-weight:900; }
    .reward p,.hint,.note { color:#aaa99f; font-size:12px; line-height:2; }
    .code-row { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:12px 14px; border:1px dashed #77643a; border-radius:12px; direction:ltr; }
    .code { color:#e2bd63; font:800 23px/1.4 ui-monospace,Consolas,monospace; letter-spacing:1.5px; }
    .copy { padding:8px 12px; border:1px solid #6f5b2e; border-radius:9px; background:#302a1b; color:#e2bd63; cursor:pointer; }
    .primary { width:100%; margin-top:16px; }
    .steps { margin-top:28px; padding-top:22px; border-top:1px solid #30312b; }
    .steps h2,.related-pages h2 { font-size:1.1rem; margin:0 0 .75rem; }
    .steps ol { padding-right:22px; color:#c0bfb4; line-height:2.2; }
    .note { margin-top:22px; }
    .related-pages { margin:2rem 0; padding:1.25rem; border:1px solid #554728; border-radius:14px; }
    .related-pages nav { display:flex; flex-wrap:wrap; gap:.7rem; }
    .related-pages nav a { color:#e2bd63; text-decoration:none; }
    @media(max-width:480px) { .card { padding:16px; } .code { font-size:19px; } }
  
    /* Coupon-detail layout inspired by the reference page */
    .result { width: min(820px, calc(100% - 32px)); padding-top: 22px; }
    .breadcrumbs { margin-bottom: 24px; }
    .intro { margin: 0 0 22px; padding: 22px 24px; border: 1px solid #38372e; border-radius: 18px; background: linear-gradient(125deg, #211f17, #171814); }
    .page-title { margin: 0 0 7px; font-size: clamp(25px, 4vw, 34px); line-height: 1.65; }
    .page-desc { margin: 0; max-width: 650px; line-height: 2.1; }
    .card { position: relative; overflow: hidden; padding: 0; border: 1px solid #5a4a2b; border-radius: 20px; background: #171814; box-shadow: 0 18px 48px #0000002b; }
    .card-head { margin: 0; padding: 22px 24px; border-bottom: 1px solid #38372e; background: linear-gradient(110deg, #242116, #191a16); }
    .platform { gap: 13px; }
    .platform-name { color: #f4f1e8; font-size: 19px; font-weight: 900; }
    .platform-caption { margin-top: 2px; color: #aaa99f; font-size: 12px; }
    .mark { width: 52px; height: 52px; flex: 0 0 52px; border: 1px solid #6a572b; border-radius: 15px; background: #fff; object-fit: contain; padding: 5px; }
    .reward { position: relative; margin: 0; padding: 24px; border: 0; border-bottom: 1px dashed #62502b; border-radius: 0; background: radial-gradient(ellipse at top right, #302719, transparent 70%), #1d1c16; text-align: center; }
    .reward::after, .reward::before { content: ""; position: absolute; bottom: -10px; width: 19px; height: 19px; border-radius: 50%; background: #101110; border: 1px solid #5a4a2b; }
    .reward::before { right: -10px; border-right: 0; border-bottom: 0; }
    .reward::after { left: -10px; border-left: 0; border-bottom: 0; }
    .reward-amount { margin: 0; color: #f0cf7b; font-size: clamp(27px, 5vw, 36px); font-weight: 950; line-height: 1.6; }
    .label { margin: 22px 24px 9px; font-size: 12px; font-weight: 700; }
    .code-row { margin: 0 24px; padding: 13px 15px; border: 1px dashed #8c713a; border-radius: 12px; background: #10110f; }
    .code { font-size: clamp(21px, 4vw, 27px); }
    .copy { padding: 10px 15px; }
    .copy-feedback { margin: 5px 24px 0; }
    .primary { width: calc(100% - 48px); min-height: 52px; margin: 13px 24px 0; border-radius: 12px; font-size: 14px; }
    .steps { margin: 23px 24px 0; padding-top: 20px; }
    .steps h2 { font-size: 16px; }
    .steps ol { font-size: 13px; }
    .note, .disclaimer { margin: 22px 24px 0; padding: 15px 0 22px; border-top: 1px solid #30312c; }
    .seo-content { margin-top: 24px; }
    @media (max-width: 520px) {
      .result { width: min(100% - 22px, 820px); padding-top: 16px; }
      .intro { padding: 16px; margin-bottom: 15px; }
      .card-head { padding: 17px 16px; }
      .mark { width: 46px; height: 46px; flex-basis: 46px; }
      .reward { padding: 21px 14px; }
      .label { margin: 20px 16px 8px; }
      .code-row { margin: 0 16px; padding: 10px; gap: 8px; }
      .copy { padding: 8px 10px; font-size: 11px; }
      .copy-feedback { margin-inline: 16px; }
      .primary { width: calc(100% - 32px); margin-inline: 16px; font-size: 12px; }
      .steps { margin-inline: 16px; }
      .note, .disclaimer { margin-inline: 16px; }
    }

  </style>

  <script>
    const copyButton = document.querySelector('#copyCode');
    const codeElement = document.querySelector('#inviteCode');
    const feedback = document.querySelector('#copyFeedback');
    copyButton?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(codeElement?.textContent?.trim() || '');
      } catch {
        const area = document.createElement('textarea');
        area.value = codeElement?.textContent?.trim() || '';
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.appendChild(area);
        area.select();
        const copied = document.execCommand('copy');
        area.remove();
        if (!copied) { feedback.textContent = 'کپی خودکار نشد؛ کد را دستی کپی کن.'; return; }
      }
      copyButton.textContent = 'کپی شد ✓';
      feedback.textContent = 'کد دعوت کپی شد.';
      setTimeout(() => copyButton.textContent = 'کپی کد', 1600);
    });
  </script>
</body>
</html>
