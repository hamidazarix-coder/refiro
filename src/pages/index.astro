---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { platforms } from '../data/platforms.js';

const title = 'رفیرو | بزرگترین مرجع کدهای دعوت در ایران';
const description = 'در رفیرو کدهای دعوت و معرف پلتفرم‌های مختلف را پیدا کن؛ کد را کپی کن یا مستقیم وارد لینک دعوت شو و پاداشت را بگیر.';
const activePlatforms = platforms.filter((platform) => platform.active).slice(0, 6);
const discountPlaceholders = Array.from({ length: 6 }, (_, index) => index + 1);
---
<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#080c15" />
  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem('refiro-theme');
        document.documentElement.dataset.theme = saved === 'light' ? 'light' : 'dark';
      } catch { document.documentElement.dataset.theme = 'dark'; }
    })();
  </script>
  <link rel="canonical" href="https://refiro.ir/" />
  <link rel="icon" type="image/svg+xml" href="/refiro-logo.svg" />
  <link rel="preload" href="/fonts/iranian-sans.ttf" as="font" type="font/ttf" crossorigin />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <meta property="og:locale" content="fa_IR" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="رفیرو" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://refiro.ir/" />
  <meta property="og:image" content="https://refiro.ir/og-cover.png" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content="رفیرو؛ مرجع کدهای دعوت و تخفیف" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://refiro.ir/og-cover.png" />
  <title>{title}</title>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {"@type":"WebSite","@id":"https://refiro.ir/#website","name":"رفیرو","alternateName":"Refiro","url":"https://refiro.ir/","inLanguage":"fa-IR","description":description},
      {"@type":"Organization","@id":"https://refiro.ir/#organization","name":"رفیرو","alternateName":"Refiro","url":"https://refiro.ir/","logo":"https://refiro.ir/refiro-logo.svg"}
    ]
  })} />
</head>
<body>
  <Header />
  <main>
    <section class="promo wrap" aria-label="جایگاه تبلیغات">
      <div class="promo-track" id="promoTrack">
        <article class="promo-slide ad-slide ad-slide-one" aria-hidden="false"><span>خوش آمدید</span></article>
        <article class="promo-slide ad-slide ad-slide-two" aria-hidden="true"><span>تبلیغات سایت شما</span></article>
        <article class="promo-slide ad-slide ad-slide-three" aria-hidden="true"><span>پول به جیب بزن</span></article>
      </div>
    </section>

    <section class="promo-duo wrap" aria-label="دو جایگاه تبلیغاتی">
      <div class="promo-duo-panel"><span>محل تبلیغات شما !</span></div>
      <div class="promo-duo-panel"><span>محل تبلیغات شما !</span></div>
    </section>

        <section class="hero wrap" aria-labelledby="heroTitle">
      <h1 id="heroTitle"><span class="hero-brand" aria-label="رفیرو">رفیرو</span><br /><span class="hero-tagline" id="heroTypewriter" aria-label="بزرگ‌ترین مرجع کد تخفیف و دعوت در ایران">بزرگ‌ترین مرجع کد تخفیف و دعوت در ایران</span></h1>

    </section>

    <section class="category-cards wrap" aria-label="دسته‌بندی کدها">
      <a class="category-card referral-card" href="/codes/">
        <div class="category-art mini-gift" aria-hidden="true"><div class="mini-gift-box"><i></i><b></b></div><span></span></div>
        <div class="category-copy"><h2>کدهای معرف</h2></div>
        <span class="category-action">مشاهده همه کدها</span>
      </a>
      <a class="category-card discount-card" href="/discounts/">
        <div class="category-art coupon-art" aria-hidden="true"><span>٪</span><i></i></div>
        <div class="category-copy"><h2>کدهای تخفیف</h2></div>
        <span class="category-action">مشاهده همه کدها</span>
      </a>
    </section>

    <section class="platform-section wrap" id="platforms" aria-labelledby="platformTitle">
      <div class="section-heading section-heading-row">
        <h2 id="platformTitle">کد های دعوت فعال</h2>
        <a class="view-all" href="/codes/">دیدن همه <span aria-hidden="true">←</span></a>
      </div>
      <div class="platform-grid" id="platformGrid">
        {activePlatforms.map((platform) => (
          <a class="platform-card" href={platform.href} data-name={platform.name}>
            <span class="card-status">فعال</span>
            <span class="platform-logo">{platform.image ? <img src={platform.image} alt="" width="48" height="48" loading="lazy" decoding="async" /> : <span>{platform.mark}</span>}</span>
            <strong>{platform.name}</strong>
            <span class="platform-chevron">‹</span>
          </a>
        ))}
      </div>
      <p class="empty hidden" id="noResult" role="status">پلتفرمی با این نام پیدا نشد. نام دیگری را امتحان کن.</p>
    </section>

    <section class="platform-section discount-section wrap" id="discounts" aria-labelledby="discountTitle">
      <div class="section-heading section-heading-row">
        <h2 id="discountTitle">کد های تخفیف</h2>
        <a class="view-all" href="/discounts/">دیدن همه <span aria-hidden="true">←</span></a>
      </div>
      <div class="platform-grid discount-grid">
        {discountPlaceholders.map((item) => (
          <a class="platform-card discount-placeholder" href="/discounts/" aria-label="کد تخفیف جدید؛ به‌زودی">
            <span class="card-status">به‌زودی</span>
            <span class="platform-logo discount-placeholder-icon" aria-hidden="true">٪</span>
            <strong>کد تخفیف جدید</strong>
            <span class="platform-chevron">‹</span>
          </a>
        ))}
      </div>
    </section>

    <section class="faq-section wrap" aria-labelledby="faqTitle">
      <h2 id="faqTitle">سؤالات متداول <span class="question-mark">ⓘ</span></h2>
      <p>پاسخ سؤالات رایج درباره کدهای دعوت و تخفیف</p>
      <div class="faq-list">
        <details><summary>رفیرو دقیقاً چیکار می‌کنه؟</summary><p>رفیرو بهت کمک می‌کنه کد دعوت یا معرف سرویس موردنظرت رو پیدا کنی؛ بعد می‌تونی کد رو برداری یا از لینک ثبت‌نام وارد بشی.</p></details>
        <details><summary>کد دعوت با کد معرف چه فرقی داره؟</summary><p>در خیلی از سرویس‌ها این دو عبارت برای یک کاربرد استفاده می‌شن: کدی که موقع ثبت‌نام برای معرفی کاربر جدید وارد می‌شه.</p></details>
        <details><summary>دریافت هدیه با کد دعوت تضمینیه؟</summary><p>پاداش و شرایط طرح‌ها ممکنه تغییر کنه و به ضوابط همون سرویس بستگی داره. پیش از ثبت‌نام، شرایط روز رو در سایت رسمی بررسی کن.</p></details>
        <details><summary>رفیرو سایت رسمی پلتفرم‌هاست؟</summary><p>خیر؛ رفیرو یک راهنمای مستقل برای پیدا کردن کدهای دعوت است. ثبت‌نام از طریق منابع رسمی هر پلتفرم انجام می‌شه.</p></details>
      </div>
    </section>
  </main>
  <Footer />

  <style>
    :global(html){scroll-behavior:smooth;scroll-padding-top:90px}
    :global(body){margin:0;background:#080c15;color:#eef0ff;overflow-x:hidden}
    :global(.wrap){width:min(1120px,calc(100% - 48px));margin-inline:auto}
    .promo{position:relative;margin-top:24px}
    .promo-duo{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}
    .promo-duo-panel{min-height:112px;display:flex;align-items:center;justify-content:center;overflow:hidden;border:1px solid #514087;border-radius:14px;background:radial-gradient(ellipse at 75% 40%,#24105a 0,#10102c 48%,#0b1020 100%);box-shadow:inset 0 0 28px #34136b24;color:#a98aff;font-size:clamp(15px,2vw,21px);font-weight:850;letter-spacing:.1px}
    .promo-duo-panel span{padding:12px;text-align:center}
    .promo-track{position:relative;height:202px;border:1px solid #514087;border-radius:16px;overflow:hidden;background:radial-gradient(ellipse at 77% 50%,#24105a 0,#10102c 36%,#0b1020 75%);box-shadow:inset 0 0 32px #34136b24}
    .promo-slide{position:absolute;inset:0;display:flex;align-items:center;justify-content:space-between;padding:20px 12%;opacity:0;pointer-events:none;transition:opacity .45s ease}
    .promo-slide[aria-hidden="false"]{opacity:1;pointer-events:auto}
    .promo-copy{position:relative;z-index:2}
    .promo-copy h2{margin:0 0 6px;font-size:clamp(19px,2.5vw,27px);font-weight:900;color:#f5f3ff}
    .promo-copy p{margin:0 0 17px;color:#aeb4ce;font-size:16px}
    .promo-copy a{display:inline-flex;align-items:center;gap:14px;padding:10px 21px;border-radius:30px;background:linear-gradient(110deg,#4b19b5,#7d2cff);color:#fff;text-decoration:none;font-weight:800;font-size:14px}
    .promo-copy a span{font-size:18px}
    .promo-arrow{position:absolute;z-index:4;top:calc(50% - 19px);width:39px;height:39px;border:0;border-radius:50%;background:#343954bd;color:white;font-size:31px;line-height:1;cursor:pointer}
    .promo-prev{right:20px}.promo-next{left:20px}
    .promo-dots{position:absolute;z-index:4;bottom:12px;left:0;right:0;display:flex;justify-content:center;gap:9px}
    .promo-dots button{width:11px;height:11px;padding:0;border:0;border-radius:50%;background:#4e5570;cursor:pointer}
    .promo-dots button.active{width:22px;border-radius:20px;background:#8b43ff}
    .promo-art{position:relative;width:245px;height:170px;flex:0 0 245px;filter:drop-shadow(0 15px 20px #7d2cff26)}
    .gift-box{position:absolute;right:35px;bottom:5px;width:145px;height:90px;border-radius:12px 12px 17px 17px;background:linear-gradient(100deg,#4c0ca4,#822cff 50%,#3b087c);box-shadow:inset -12px 0 18px #18043e,inset 4px 0 10px #bb7bff}
    .gift-box:before{content:"";position:absolute;top:-29px;left:-10px;width:165px;height:37px;border-radius:9px;background:linear-gradient(110deg,#7022d4,#a74dff,#5914a8);border:1px solid #b66aff}
    .gift-box i{position:absolute;z-index:1;top:-28px;bottom:0;left:55px;width:22px;background:linear-gradient(90deg,#ffb32c,#ffe178,#e87900)}
    .gift-box b{position:absolute;z-index:2;top:-30px;left:25px;width:22px;height:31px;border:7px solid #ffb22a;border-radius:80% 20% 70% 20%;transform:rotate(-32deg)}
    .gift-box span{position:absolute;z-index:2;top:-36px;left:67px;width:24px;height:35px;border:7px solid #ffb22a;border-radius:20% 80% 20% 80%;transform:rotate(32deg)}
    .gift-bow{position:absolute;z-index:3;right:86px;top:4px;width:70px;height:36px;border:9px solid #ffb52e;border-radius:70% 25% 70% 25%;transform:rotate(17deg);filter:drop-shadow(0 2px 2px #321044)}
    .percent-tag{position:absolute;z-index:4;bottom:2px;right:5px;padding:3px 10px;border:2px solid #6e36d8;border-radius:8px;background:linear-gradient(145deg,#6323ca,#2d0d73);color:#ffc34b;font-size:43px;font-weight:950;transform:rotate(17deg);box-shadow:0 8px 14px #05030d66}
    .slide-two{background:radial-gradient(ellipse at 78% 45%,#382000,#10101d 63%,#0b1020)}
    .big-ticket{position:absolute;top:35px;right:45px;width:145px;height:94px;border-radius:12px;background:linear-gradient(145deg,#ffc33b,#df7900);color:#fff0a2;display:grid;place-items:center;transform:rotate(-12deg);box-shadow:inset 0 0 0 2px #ffda6a,0 10px 22px #0008}
    .big-ticket span{font-size:68px;font-weight:950;text-shadow:0 4px 0 #ad5900}
    .big-ticket:before,.big-ticket:after{content:"";position:absolute;top:33px;width:18px;height:28px;border-radius:50%;background:#201326}
    .big-ticket:before{right:-9px}.big-ticket:after{left:-9px}
    .big-ticket i{position:absolute;inset:8px;border:2px dashed #b96600;border-radius:7px}
    .slide-three{background:radial-gradient(ellipse at 80% 45%,#182b64,#10102b 60%,#0b1020)}
    .coin-stack{position:absolute;right:65px;top:23px;display:grid;place-items:center;width:105px;height:105px;border-radius:50%;background:linear-gradient(145deg,#d2a7ff,#7525e9 60%,#351077);box-shadow:0 14px 0 #35116e,0 25px 30px #0008;color:#fff;font-size:56px}
    .coin{position:absolute;display:grid;place-items:center;width:58px;height:58px;border-radius:50%;background:linear-gradient(145deg,#f5c65a,#d98210);border:3px solid #ffdf76;color:#fff;font-weight:950;font-size:27px}
    .coin-a{right:14px;bottom:12px}.coin-b{right:155px;top:17px}
    .hero{padding-top:53px;text-align:center}
    .hero h1{margin:0;color:#e9eafa;font-size:clamp(34px,5vw,52px);font-weight:950;line-height:1.5;letter-spacing:-1.3px}
    .hero h1 span{color:#9145ff;text-shadow:0 0 28px #812cff24}
    .hero h1 .hero-brand{
      display:inline-block;
      position:relative;
      padding:0 .16em .08em;
      color:#ffd12e !important;
      -webkit-text-fill-color:#ffd12e !important;
      background:none;
      border:0;
      border-radius:0;
      box-shadow:none;
      clip-path:none;
      letter-spacing:-1.3px;
      line-height:1.2;
      text-shadow:0 3px 18px #f0b42938;
      direction:rtl;
      unicode-bidi:isolate;
    }
    :global(html[data-theme="light"] .hero h1 .hero-brand){
      color:#b77900 !important;
      -webkit-text-fill-color:#b77900 !important;
      text-shadow:none;
    }
    .hero h1 .hero-tagline{display:inline-block;white-space:nowrap;font-size:clamp(16px,2.35vw,25px);line-height:1.5;color:#9145ff;text-shadow:0 0 28px #812cff24}
    .hero h1 .hero-tagline{min-height:1.5em}
    .hero h1 .hero-tagline::after{content:"";display:inline-block;width:2px;height:.95em;margin-right:5px;vertical-align:-.12em;background:currentColor;animation:type-caret .8s steps(1,end) infinite}
    @keyframes type-caret{50%{opacity:0}}
    :global(html[data-theme="light"] .hero h1 .hero-brand){color:#fff;-webkit-text-fill-color:initial}
    :global(html[data-theme="light"] .hero h1 .hero-tagline){color:#9145ff}
    @media(max-width:520px){.hero h1 .hero-tagline{font-size:clamp(12px,3.5vw,17px);letter-spacing:-.6px}}
    .hero-description{margin:13px auto 26px;color:#aeb5ca;font-size:17px;line-height:2}
    .category-cards{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:50px}
    .category-card{position:relative;min-height:236px;display:grid;grid-template-columns:43% 57%;grid-template-rows:1fr;align-items:center;gap:0 5px;padding:23px 28px;border:1px solid;border-radius:20px;text-decoration:none;overflow:hidden;transition:transform .2s,box-shadow .2s}
    .category-card:hover{transform:translateY(-3px)}
    .referral-card{border-color:#8d35ff;background:radial-gradient(ellipse at 22% 25%,#35145e,#17102f 70%);box-shadow:0 0 22px #852bff15}
    .discount-card{border-color:#ffab00;background:radial-gradient(ellipse at 22% 25%,#30200a,#171718 70%);box-shadow:0 0 22px #ffab0011}
    .category-copy h2{margin:0 0 11px;color:#f8f6ff;font-size:27px;font-weight:900;white-space:nowrap}
    .category-copy p{margin:0;color:#d1d4e3;font-size:14px;line-height:2}
    .category-art{position:relative;grid-row:1;grid-column:1;justify-self:center;width:150px;height:135px;display:grid;place-items:center}
    .coupon-art span{display:grid;place-items:center;width:123px;height:83px;border:2px solid #ffcb45;border-radius:12px;background:linear-gradient(140deg,#ffc53d,#e98c00);color:#fff2a4;font-size:61px;font-weight:950;transform:rotate(-13deg);box-shadow:inset 0 0 0 5px #f4a51d,0 8px 20px #0005;text-shadow:0 3px 0 #ad5d00}
    .coupon-art i{position:absolute;top:27px;left:19px;width:5px;height:77px;border-left:3px dashed #a95b00;transform:rotate(-13deg)}
    .mini-gift{filter:drop-shadow(0 10px 12px #0005)}
    .mini-gift-box{position:absolute;bottom:15px;width:124px;height:79px;border-radius:9px 9px 13px 13px;background:linear-gradient(100deg,#4b0d9c,#7e2be8,#380b75);box-shadow:inset -10px 0 15px #18043e}
    .mini-gift-box:before{content:"";position:absolute;top:-23px;left:-8px;width:140px;height:29px;border-radius:8px;background:linear-gradient(100deg,#6a1fc8,#a64cff,#53129d);border:1px solid #ba70ff}
    .mini-gift-box i{position:absolute;top:-22px;bottom:0;left:48px;width:20px;background:linear-gradient(90deg,#ffad27,#ffe37d,#e77d00)}
    .mini-gift-box b{position:absolute;top:-42px;left:28px;width:25px;height:31px;border:7px solid #ffb52e;border-radius:80% 20% 70% 20%;transform:rotate(-34deg)}
    .mini-gift>span{position:absolute;top:7px;left:74px;width:24px;height:31px;border:7px solid #ffb52e;border-radius:20% 80% 20% 80%;transform:rotate(32deg)}
    .category-action{grid-column:1 / -1;display:flex;align-items:center;justify-content:center;gap:18px;height:57px;border:1px solid;border-radius:21px;color:#fff;font-size:15px;font-weight:850}
    .category-action b{font-size:25px;font-weight:400;line-height:1}
    .referral-card .category-action{border-color:#913dff;background:linear-gradient(100deg,#5120b3,#351078)}
    .discount-card .category-action{border-color:#ffb10b;background:linear-gradient(100deg,#b97508,#754009)}
    .platform-section{padding-top:64px}
    .section-heading{text-align:center;margin-bottom:27px}
    .section-heading h2{margin:0 0 5px;font-size:25px;font-weight:900;color:#e7e9fa}
    .section-heading p{margin:0;color:#aab2c9;font-size:14px}
    .section-heading-row{display:flex;align-items:center;justify-content:space-between;gap:12px;text-align:right;margin-bottom:22px}
    .section-heading-row h2{margin:0;font-size:23px}
    .view-all{display:inline-flex;align-items:center;gap:8px;color:#a77aff;text-decoration:none;font-size:14px;font-weight:800;white-space:nowrap}
    .view-all:hover{color:#d3b8ff}
    .discount-section{padding-top:8px}
    .discount-placeholder{border-color:#58421c;background:linear-gradient(145deg,#211b0e,#11110f)}
    .discount-placeholder:hover{border-color:#e5a92b;background:#211a0b}
    .discount-placeholder-icon{background:linear-gradient(145deg,#ffc53d,#e98c00);color:#fff2a4;font-size:28px;font-weight:950}
    .discount-placeholder .card-status{background:#76520b;color:#fff0bd}
    :global(html[data-theme="light"] .section-heading-row h2){color:#17263a}
    :global(html[data-theme="light"] .view-all){color:#6833b6}
    :global(html[data-theme="light"] .discount-placeholder){background:#fffaf0;border-color:#ead6a7;color:#17263a}
    :global(html[data-theme="light"] .discount-placeholder-icon){color:#fff2a4}
    .green-dot{display:inline-block;width:13px;height:13px;margin-left:8px;border-radius:50%;background:#17b779;box-shadow:0 0 14px #17b77935}
    .platform-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px}
    .platform-card{position:relative;min-height:142px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:18px 10px 12px;border:1px solid #16424a;border-radius:15px;background:linear-gradient(145deg,#0c1722,#0a101a);color:#eef0ff;text-decoration:none;transition:border-color .2s,transform .2s,background .2s}
    .platform-card:hover{border-color:#8b45ef;transform:translateY(-3px);background:#12152a}
    .card-status{position:absolute;top:12px;right:12px;padding:3px 12px;border-radius:20px;background:#23844f;color:#e7fff1;font-size:11px;font-weight:800}
    .platform-logo{width:43px;height:43px;display:grid;place-items:center;margin-top:7px;border-radius:50%;overflow:hidden;color:#fff;font-size:22px;font-weight:900}
    .platform-logo img{width:100%;height:100%;object-fit:contain;border-radius:50%}
    .platform-card strong{font-size:15px;font-weight:800}
    .platform-chevron{position:absolute;bottom:24px;right:22px;color:#3f5675;font-size:24px;line-height:1}
    .new-platform{border:1px dashed #35435d;background:transparent;color:#aeb5cb}
    .new-platform .plus{display:grid;place-items:center;width:41px;height:41px;margin-bottom:2px;border-radius:50%;background:#202a40;color:#f3f4ff;font-size:28px;line-height:1}
    .new-platform strong{font-weight:600}
    .empty{text-align:center;color:#aeb5cb;padding:20px}
    .hidden{display:none!important}
    .faq-section{padding-top:43px;padding-bottom:60px;text-align:center}
